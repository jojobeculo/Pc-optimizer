{
  "schemaVersion": 1,
  "tweaks": [
    {
      "id": "input.mouse.accel",
      "category": "Input",
      "group": {
        "fr": "Souris et clavier",
        "en": "Mouse & keyboard"
      },
      "name": {
        "fr": "Désactiver « Améliorer la précision du pointeur »",
        "en": "Disable \"Enhance pointer precision\""
      },
      "description": {
        "fr": "Supprime l'accélération du pointeur Windows.",
        "en": "Removes Windows pointer acceleration."
      },
      "impact": {
        "fr": "Visée plus constante au bureau et dans les jeux sans « raw input ». Aucun effet sur les FPS ; sans effet dans les jeux utilisant le raw input.",
        "en": "More consistent aim on the desktop and in games without raw input. No FPS effect; none in raw-input games."
      },
      "regressions": {
        "fr": "Préférence : certains utilisateurs préfèrent l'accélération.",
        "en": "Preference: some users prefer acceleration."
      },
      "confidence": "Confirmed",
      "risk": "None",
      "kind": "Comfort",
      "restart": "None",
      "profiles": [
        "Balanced",
        "Maximum"
      ],
      "actions": [
        {
          "type": "spi",
          "name": "mouseAcceleration",
          "value": "0,0,0"
        }
      ]
    },
    {
      "id": "input.stickykeys",
      "category": "Input",
      "group": {
        "fr": "Souris et clavier",
        "en": "Mouse & keyboard"
      },
      "name": {
        "fr": "Désactiver le raccourci des touches rémanentes",
        "en": "Disable Sticky Keys shortcut"
      },
      "description": {
        "fr": "Empêche la fenêtre des touches rémanentes après 5 appuis sur Maj.",
        "en": "Prevents the Sticky Keys prompt after pressing Shift 5 times."
      },
      "impact": {
        "fr": "Confort en jeu (pas d'interruption).",
        "en": "In-game comfort (no interruption)."
      },
      "regressions": {
        "fr": "Aucune connue.",
        "en": "None known."
      },
      "confidence": "Confirmed",
      "risk": "None",
      "kind": "Comfort",
      "restart": "SignOut",
      "profiles": [
        "Balanced",
        "Maximum"
      ],
      "actions": [
        {
          "type": "registry",
          "path": "HKCU\\Control Panel\\Accessibility\\StickyKeys",
          "name": "Flags",
          "valueKind": "String",
          "value": "506"
        }
      ]
    },
    {
      "id": "net.repair.autotuning",
      "category": "Network",
      "group": {
        "fr": "Réseau",
        "en": "Network"
      },
      "name": {
        "fr": "Auto-réglage de la fenêtre TCP sur « normal »",
        "en": "TCP window auto-tuning to normal"
      },
      "description": {
        "fr": "Réparation : désactiver l'auto-tuning (conseil répandu) réduit fortement le débit sans améliorer le ping.",
        "en": "Repair: disabling auto-tuning (common advice) greatly reduces throughput without improving ping."
      },
      "impact": {
        "fr": "Restaure le débit des téléchargements.",
        "en": "Restores download throughput."
      },
      "regressions": {
        "fr": "Aucune connue.",
        "en": "None known."
      },
      "confidence": "Confirmed",
      "risk": "None",
      "kind": "Repair",
      "restart": "None",
      "profiles": [
        "Light",
        "Balanced",
        "Maximum"
      ],
      "actions": [
        {
          "type": "handler",
          "name": "net.autotuning.normal"
        }
      ]
    },
    {
      "id": "net.eee",
      "category": "Network",
      "group": {
        "fr": "Réseau",
        "en": "Network"
      },
      "name": {
        "fr": "Désactiver l'Ethernet économe en énergie (EEE)",
        "en": "Disable Energy-Efficient Ethernet (EEE)"
      },
      "description": {
        "fr": "Mot-clé normalisé *EEE des cartes Ethernet physiques.",
        "en": "Standardized *EEE keyword of physical Ethernet adapters."
      },
      "impact": {
        "fr": "Supprime les micro-latences de sortie de veille du lien (LPI) ; gain faible.",
        "en": "Removes link low-power-idle exit micro-latencies; small gain."
      },
      "regressions": {
        "fr": "Légère hausse de consommation ; coupure réseau de quelques secondes à l'application.",
        "en": "Slightly higher power; network drops for a few seconds when applied."
      },
      "confidence": "Probable",
      "risk": "Low",
      "kind": "Latency",
      "restart": "AdapterRestart",
      "profiles": [
        "Balanced",
        "Maximum"
      ],
      "actions": [
        {
          "type": "netAdapterProperty",
          "name": "*EEE",
          "value": "0",
          "filter": "ethernet"
        }
      ],
      "conditions": [
        {
          "fact": "net.hasEthernet",
          "op": "isTrue",
          "reason": {
            "fr": "Aucune carte Ethernet physique.",
            "en": "No physical Ethernet adapter."
          }
        }
      ]
    },
    {
      "id": "net.intmod",
      "category": "Network",
      "group": {
        "fr": "Réseau",
        "en": "Network"
      },
      "name": {
        "fr": "Désactiver la modération des interruptions",
        "en": "Disable interrupt moderation"
      },
      "description": {
        "fr": "Chaque paquet génère une interruption.",
        "en": "Every packet raises an interrupt."
      },
      "impact": {
        "fr": "Latence légèrement réduite au prix d'une charge CPU plus élevée ; résultats variables.",
        "en": "Slightly lower latency at the cost of higher CPU load; variable results."
      },
      "regressions": {
        "fr": "Charge CPU plus élevée à fort débit.",
        "en": "Higher CPU load at high throughput."
      },
      "confidence": "Experimental",
      "risk": "Medium",
      "kind": "Latency",
      "restart": "AdapterRestart",
      "profiles": [],
      "actions": [
        {
          "type": "netAdapterProperty",
          "name": "*InterruptModeration",
          "value": "0",
          "filter": "ethernet"
        }
      ],
      "conditions": [
        {
          "fact": "net.hasEthernet",
          "op": "isTrue"
        }
      ]
    },
    {
      "id": "storage.trim",
      "category": "Storage",
      "group": {
        "fr": "Stockage et maintenance",
        "en": "Storage & maintenance"
      },
      "name": {
        "fr": "TRIM activé",
        "en": "TRIM enabled"
      },
      "description": {
        "fr": "Réparation : TRIM informe le SSD des blocs libérés.",
        "en": "Repair: TRIM tells the SSD which blocks are free."
      },
      "impact": {
        "fr": "Indispensable pour maintenir les performances d'écriture d'un SSD.",
        "en": "Essential to keep SSD write performance."
      },
      "regressions": {
        "fr": "Aucune connue.",
        "en": "None known."
      },
      "confidence": "Confirmed",
      "risk": "None",
      "kind": "Repair",
      "restart": "None",
      "profiles": [
        "Light",
        "Balanced",
        "Maximum"
      ],
      "actions": [
        {
          "type": "registry",
          "path": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\FileSystem",
          "name": "DisableDeleteNotification",
          "valueKind": "DWord",
          "value": 0
        }
      ],
      "conditions": [
        {
          "fact": "storage.hasSsd",
          "op": "isTrue",
          "reason": {
            "fr": "Aucun SSD détecté.",
            "en": "No SSD detected."
          }
        }
      ]
    },
    {
      "id": "storage.retrim",
      "category": "Storage",
      "group": {
        "fr": "Stockage et maintenance",
        "en": "Storage & maintenance"
      },
      "name": {
        "fr": "ReTrim des SSD",
        "en": "ReTrim SSDs"
      },
      "description": {
        "fr": "Exécute l'optimisation Windows (defrag.exe /L) sur les volumes SSD. Jamais de défragmentation classique sur SSD.",
        "en": "Runs Windows optimization (defrag.exe /L) on SSD volumes. Never classic defragmentation on SSDs."
      },
      "impact": {
        "fr": "Maintenance ; utile si l'optimisation planifiée n'a pas tourné depuis longtemps.",
        "en": "Maintenance; useful if scheduled optimization has not run for a long time."
      },
      "regressions": {
        "fr": "Aucune connue.",
        "en": "None known."
      },
      "confidence": "Confirmed",
      "risk": "None",
      "kind": "Maintenance",
      "restart": "None",
      "profiles": [
        "Light",
        "Balanced",
        "Maximum"
      ],
      "actions": [
        {
          "type": "handler",
          "name": "storage.retrim"
        }
      ],
      "conditions": [
        {
          "fact": "storage.hasSsd",
          "op": "isTrue"
        }
      ],
      "reversible": false
    },
    {
      "id": "cleanup.temp.user",
