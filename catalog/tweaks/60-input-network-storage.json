    {
      "id": "security.vmp",
      "category": "Security",
      "group": {
        "fr": "Sécurité (analyse)",
        "en": "Security (analysis)"
      },
      "name": {
        "fr": "Désactiver la Plateforme de machine virtuelle",
        "en": "Disable Virtual Machine Platform"
      },
      "description": {
        "fr": "Fonctionnalité facultative de Windows. Microsoft indique qu'elle peut réduire les performances en jeu sur certaines configurations. Ce n'est pas une protection de sécurité.",
        "en": "Optional Windows feature. Microsoft states it can reduce gaming performance on some configurations. It is not a security protection."
      },
      "impact": {
        "fr": "Gain variable selon la machine (à mesurer avec le Benchmark).",
        "en": "Machine-dependent gain (measure with Benchmark)."
      },
      "regressions": {
        "fr": "WSL 2, Windows Subsystem for Android, Windows Sandbox et certaines machines virtuelles ne fonctionnent plus.",
        "en": "WSL 2, Windows Subsystem for Android, Windows Sandbox and some VMs stop working."
      },
      "confidence": "Probable",
      "risk": "Medium",
      "kind": "Performance",
      "restart": "Reboot",
      "profiles": [
        "Maximum"
      ],
      "actions": [
        {
          "type": "optionalFeature",
          "name": "VirtualMachinePlatform",
          "enabled": false
        }
      ],
      "conditions": [
        {
          "fact": "security.vmpEnabled",
          "op": "isTrue",
          "reason": {
            "fr": "La Plateforme de machine virtuelle n'est pas activée.",
            "en": "Virtual Machine Platform is not enabled."
          }
        }
      ],
      "sources": [
        "https://support.microsoft.com/en-us/windows/options-to-optimize-gaming-performance-in-windows-11-a255f612-2949-4373-a566-ff6f3f474613"
      ],
      "requiresConsent": true
    }
