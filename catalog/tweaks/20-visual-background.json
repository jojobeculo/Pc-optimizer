{
  "schemaVersion": 1,
  "tweaks": [
    {
      "id": "visual.transparency",
      "category": "Windows",
      "group": {
        "fr": "Effets visuels et interface",
        "en": "Visual effects & shell"
      },
      "name": {
        "fr": "Désactiver la transparence",
        "en": "Disable transparency effects"
      },
      "description": {
        "fr": "Désactive l'effet acrylique/mica de l'interface Windows.",
        "en": "Disables Windows acrylic/mica effects."
      },
      "impact": {
        "fr": "Améliore la réactivité du bureau sur GPU intégré modeste ; aucun effet en jeu plein écran.",
        "en": "Improves desktop responsiveness on modest integrated GPUs; no effect in full-screen games."
      },
      "regressions": {
        "fr": "Esthétique uniquement.",
        "en": "Cosmetic only."
      },
      "confidence": "Probable",
      "risk": "None",
      "kind": "Responsiveness",
      "restart": "None",
      "profiles": [
        "Light",
        "Balanced",
        "Maximum"
      ],
      "actions": [
        {
          "type": "registry",
          "path": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
          "name": "EnableTransparency",
          "valueKind": "DWord",
          "value": 0
        }
      ]
    },
