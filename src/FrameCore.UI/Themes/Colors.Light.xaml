<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Bg0">#F5F6F8</Color>
    <Color x:Key="Color.Accent">#087A55</Color>
    <Color x:Key="Color.Card">#FFFFFF</Color>
    <SolidColorBrush x:Key="Brush.Bg0" Color="#F5F6F8"/>
