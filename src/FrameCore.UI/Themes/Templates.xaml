<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:i="clr-namespace:FrameCore.UI.Infrastructure">

    <i:BoolToVisibilityConverter x:Key="T.BoolToVis"/>
    <i:LevelToBrushConverter x:Key="T.LevelBrush"/>
    <i:LocKeyConverter x:Key="T.LocKey"/>
    <i:SeverityIconConverter x:Key="T.SeverityIcon"/>

    <!-- Diagnostic finding -->
    <DataTemplate x:Key="FindingTemplate">
        <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="8" VerticalAlignment="Top"
                        Background="{Binding Severity, Converter={StaticResource T.LevelBrush}, ConverterParameter=soft}">
                    <i:Icon Glyph="{Binding Severity, Converter={StaticResource T.SeverityIcon}}" Width="17" Height="17"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Severity, Converter={StaticResource T.LevelBrush}}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,12,0">
                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"/>
                    <TextBlock Text="{Binding Detail}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,3,0,0"/>
                    <TextBlock Text="{Binding Recommendation}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" Margin="0,5,0,0"
                               Visibility="{Binding Recommendation, Converter={StaticResource T.BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding Steps}" Margin="0,4,0,0" Visibility="{Binding Steps, Converter={StaticResource T.BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,0,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Context}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextFaint}" Margin="0,4,0,0"
                               Visibility="{Binding Context, Converter={StaticResource T.BoolToVis}}"/>
                    <WrapPanel Margin="0,6,0,0">
                        <Border CornerRadius="6" Padding="7,2" Margin="0,0,6,0" Background="{Binding Confidence, Converter={StaticResource T.LevelBrush}, ConverterParameter=soft}">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding Confidence, Converter={StaticResource T.LevelBrush}}"
                                       Text="{Binding Confidence, Converter={StaticResource T.LocKey}, ConverterParameter=confidence.}"/>
                        </Border>
                        <Border CornerRadius="6" Padding="7,2" Background="{DynamicResource Brush.NeutralSoft}">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding Category, Converter={StaticResource T.LocKey}, ConverterParameter=pro.cat.}"/>
                        </Border>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding Links}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{DynamicResource Button.Ghost}" HorizontalAlignment="Left" Content="{Binding Label}" ToolTip="{Binding Url}"
                                        Command="{Binding DataContext.OpenUriCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Url}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Button Grid.Column="2" VerticalAlignment="Top" Style="{DynamicResource Button.Small}"
                        Content="{Binding ActionLabel, TargetNullValue='→', FallbackValue='→'}"
                        Visibility="{Binding ActionId, Converter={StaticResource T.BoolToVis}}"
                        Command="{Binding DataContext.FindingActionCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Badges row for an optimization -->
    <DataTemplate x:Key="TweakBadges">
        <WrapPanel>
            <Border CornerRadius="6" Padding="7,2" Margin="0,0,6,4" Background="{Binding Status, Converter={StaticResource T.LevelBrush}, ConverterParameter=soft}">
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding Status, Converter={StaticResource T.LevelBrush}}" Text="{Binding Status, Converter={StaticResource T.LocKey}, ConverterParameter=status.}"/>
            </Border>
            <Border CornerRadius="6" Padding="7,2" Margin="0,0,6,4" Background="{Binding Confidence, Converter={StaticResource T.LevelBrush}, ConverterParameter=soft}">
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding Confidence, Converter={StaticResource T.LevelBrush}}" Text="{Binding Confidence, Converter={StaticResource T.LocKey}, ConverterParameter=confidence.}"/>
            </Border>
            <Border CornerRadius="6" Padding="7,2" Margin="0,0,6,4" Background="{Binding Risk, Converter={StaticResource T.LevelBrush}, ConverterParameter=soft}">
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{Binding Risk, Converter={StaticResource T.LevelBrush}}" Text="{Binding Risk, Converter={StaticResource T.LocKey}, ConverterParameter=risk.}"/>
            </Border>
            <Border CornerRadius="6" Padding="7,2" Margin="0,0,6,4" Background="{DynamicResource Brush.NeutralSoft}">
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding Kind, Converter={StaticResource T.LocKey}, ConverterParameter=kind.}"/>
            </Border>
            <Border CornerRadius="6" Padding="7,2" Margin="0,0,6,4" Background="{DynamicResource Brush.InfoSoft}" Visibility="{Binding NeedsRestart, Converter={StaticResource T.BoolToVis}}">
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Info}" Text="{Binding Restart, Converter={StaticResource T.LocKey}, ConverterParameter=restart.}"/>
            </Border>
            <Border CornerRadius="6" Padding="7,2" Margin="0,0,6,4" Background="{DynamicResource Brush.WarningSoft}" Visibility="{Binding NeedsElevation, Converter={StaticResource T.BoolToVis}}">
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}" Text="{i:Loc tweak.admin}"/>
            </Border>
        </WrapPanel>
    </DataTemplate>

    <!-- Expandable technical details -->
    <DataTemplate x:Key="TweakDetails">
        <Expander Header="{i:Loc tweak.details}" Margin="0,8,0,0" Foreground="{DynamicResource Brush.TextMuted}">
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="7" Text="{i:Loc tweak.objective}" Style="{DynamicResource Text.Label}" Margin="0,4,8,4"/>
                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Objective}" Style="{DynamicResource Text.Value}" Margin="0,4,0,4"/>
                <TextBlock Grid.Row="8" Text="{i:Loc tweak.impactAreas}" Style="{DynamicResource Text.Label}" Margin="0,4,8,4"/>
                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding ImpactAreasText}" Style="{DynamicResource Text.Value}" Margin="0,4,0,4"/>
                <TextBlock Grid.Row="9" Text="{i:Loc tweak.persistence}" Style="{DynamicResource Text.Label}" Margin="0,4,8,4"/>
                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding PersistenceText}" Style="{DynamicResource Text.Value}" Margin="0,4,0,4"/>
                <TextBlock Grid.Row="10" Text="{i:Loc tweak.verification}" Style="{DynamicResource Text.Label}" Margin="0,4,8,4"/>
                <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding VerificationText}" Style="{DynamicResource Text.Value}" Margin="0,4,0,4"/>
                <TextBlock Grid.Row="11" Text="{i:Loc tweak.restoration}" Style="{DynamicResource Text.Label}" Margin="0,4,8,4"/>
                <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding RestorationText}" Style="{DynamicResource Text.Value}" Margin="0,4,0,4"/>
                <TextBlock Grid.Row="12" Text="{i:Loc tweak.conflicts}" Style="{DynamicResource Text.Label}" Margin="0,4,8,4"/>
                <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding ConflictsText}" Style="{DynamicResource Text.Value}" Margin="0,4,0,4"/>
                <TextBlock Grid.Row="0" Text="{i:Loc tweak.impact}" Style="{DynamicResource Text.Label}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Impact}" Style="{DynamicResource Text.Value}"/>
                <TextBlock Grid.Row="1" Text="{i:Loc tweak.regressions}" Style="{DynamicResource Text.Label}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Regressions}" Style="{DynamicResource Text.Value}"/>
                <TextBlock Grid.Row="2" Text="{i:Loc tweak.compatibility}" Style="{DynamicResource Text.Label}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Compatibility}" Style="{DynamicResource Text.Value}"/>
                <TextBlock Grid.Row="3" Text="{i:Loc tweak.profiles}" Style="{DynamicResource Text.Label}"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProfilesText}" Style="{DynamicResource Text.Value}"/>
                <TextBlock Grid.Row="4" Text="{i:Loc tweak.reversible}" Style="{DynamicResource Text.Label}"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Reversible, Converter={StaticResource T.LocKey}, ConverterParameter=bool.}" Style="{DynamicResource Text.Value}"/>
                <TextBlock Grid.Row="5" Text="{i:Loc tweak.id}" Style="{DynamicResource Text.Label}"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Id}" Style="{DynamicResource Text.Value}" FontFamily="{DynamicResource Font.Mono}"/>
                <TextBlock Grid.Row="6" Text="{i:Loc tweak.sources}" Style="{DynamicResource Text.Label}" Visibility="{Binding HasSources, Converter={StaticResource T.BoolToVis}}"/>
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Sources}" Style="{DynamicResource Text.Value}" Visibility="{Binding HasSources, Converter={StaticResource T.BoolToVis}}"/>
            </Grid>
        </Expander>
    </DataTemplate>

    <!-- Current vs recommended value -->
    <DataTemplate x:Key="TweakValues">
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource Brush.Inset}" CornerRadius="8" Padding="10,6">
                <StackPanel>
                    <TextBlock Text="{i:Loc tweak.current}" FontSize="11" Foreground="{DynamicResource Brush.TextFaint}"/>
                    <TextBlock Text="{Binding CurrentValue}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" FontFamily="{DynamicResource Font.Mono}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource Brush.Inset}" CornerRadius="8" Padding="10,6">
                <StackPanel>
                    <TextBlock Text="{i:Loc tweak.recommended}" FontSize="11" Foreground="{DynamicResource Brush.TextFaint}"/>
                    <TextBlock Text="{Binding TargetValue}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" FontFamily="{DynamicResource Font.Mono}"/>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- Pro mode card -->
    <DataTemplate x:Key="TweakCardTemplate">
        <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Group}" FontSize="11" Foreground="{DynamicResource Brush.TextFaint}"/>
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" Margin="0,1,0,6"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TweakBadges}"/>
                    <TextBlock Text="{Binding Description}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,4,0,0"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TweakValues}"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TweakDetails}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" MinWidth="120">
                    <Button Content="{i:Loc common.apply}" Style="{DynamicResource Button.SmallPrimary}" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}" Margin="0,0,0,6"/>
                    <Button Content="{i:Loc common.restore}" Style="{DynamicResource Button.Small}" Command="{Binding RestoreCommand}" IsEnabled="{Binding CanRestore}"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Plan item (simple mode) -->
    <DataTemplate x:Key="PlanItemTemplate">
        <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,4"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TweakBadges}"/>
                    <TextBlock Text="{Binding Description}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TweakValues}"/>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TweakDetails}"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Key/value rows -->
    <DataTemplate x:Key="PropertyRowTemplate">
        <Grid Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" Margin="0,0,12,6"/>
            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" Margin="0,0,0,6"/>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TitledRowsTemplate">
        <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource PropertyRowTemplate}"/>
                <ItemsControl ItemsSource="{Binding Volumes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,8,0,0">
                                <DockPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource Brush.Text}"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
