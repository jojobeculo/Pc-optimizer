<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- FrameCore design tokens. Fonts are embedded (SIL OFL 1.1) so the interface looks identical offline. -->
    <FontFamily x:Key="Font.Ui">/FrameCore;component/Assets/Fonts/#Inter, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">/FrameCore;component/Assets/Fonts/#Space Grotesk, Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="Font.Mono">/FrameCore;component/Assets/Fonts/#JetBrains Mono, Consolas</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Type scale (px): display 30 · h1 24 · h2 18 · h3 15 · body 13.5 · small 12 · caption 11 -->
    <sys:Double x:Key="Size.Display">30</sys:Double>
    <sys:Double x:Key="Size.H1">24</sys:Double>
    <sys:Double x:Key="Size.H2">18</sys:Double>
    <sys:Double x:Key="Size.H3">15</sys:Double>
    <sys:Double x:Key="Size.Body">13.5</sys:Double>
    <sys:Double x:Key="Size.Small">12</sys:Double>
    <sys:Double x:Key="Size.Caption">11</sys:Double>
    <sys:Double x:Key="Size.Metric">28</sys:Double>

    <!-- Spacing on a 4 px grid -->
    <Thickness x:Key="Pad.Card">20</Thickness>
    <Thickness x:Key="Pad.CardCompact">16,14</Thickness>
    <Thickness x:Key="Pad.Page">32,24,32,32</Thickness>
    <Thickness x:Key="Gap.Section">0,0,0,24</Thickness>
    <Thickness x:Key="Gap.Item">0,0,0,12</Thickness>

    <!-- Radii -->
    <CornerRadius x:Key="Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Hero">16</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- Motion (ignored when Windows animations are turned off) -->
    <Duration x:Key="Motion.Fast">0:0:0.12</Duration>
    <Duration x:Key="Motion.Normal">0:0:0.2</Duration>
    <Duration x:Key="Motion.Slow">0:0:0.32</Duration>
    <CubicEase x:Key="Ease.Out" EasingMode="EaseOut"/>
</ResourceDictionary>
