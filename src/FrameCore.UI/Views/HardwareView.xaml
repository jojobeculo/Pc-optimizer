<UserControl x:Class="FrameCore.UI.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:FrameCore.UI.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Pad.Page}">
            <TextBlock Text="{i:Loc hw.title}" Style="{StaticResource Text.PageTitle}"/>
            <TextBlock Text="{i:Loc hw.subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,18"/>

            <WrapPanel Margin="0,0,0,14">
                <RadioButton Style="{StaticResource Segment}" Content="{i:Loc hw.cpu}" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=cpu}"/>
                <RadioButton Style="{StaticResource Segment}" Content="{i:Loc hw.gpu}" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=gpu}"/>
                <RadioButton Style="{StaticResource Segment}" Content="{i:Loc hw.ram}" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=ram}"/>
                <RadioButton Style="{StaticResource Segment}" Content="{i:Loc hw.board}" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=board}"/>
                <RadioButton Style="{StaticResource Segment}" Content="{i:Loc hw.storage}" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=storage}"/>
                <RadioButton Style="{StaticResource Segment}" Content="{i:Loc hw.display}" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=display}"/>
                <RadioButton Style="{StaticResource Segment}" Content="{i:Loc hw.network}" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=network}"/>
                <RadioButton Style="{StaticResource Segment}" Content="{i:Loc hw.windows}" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=windows}"/>
                <RadioButton Style="{StaticResource Segment}" Content="{i:Loc dq.title}" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=quality}"/>
            </WrapPanel>

            <!-- CPU -->
            <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=cpu}">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{i:Loc hw.live}" Style="{StaticResource Text.Section}"/>
                        <TextBlock Text="{Binding CpuLive}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8"/>
                        <i:SparkChart Values="{Binding CpuHistory}" Height="80" Stroke="{DynamicResource Brush.Chart1}" Fill="{DynamicResource Brush.ChartFill}" GridBrush="{DynamicResource Brush.Grid}" Capacity="120"/>
                        <TextBlock Text="{i:Loc hw.perCore}" Style="{StaticResource Text.Caption}" Margin="0,10,0,4"/>
                        <ItemsControl ItemsSource="{Binding PerCore}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="64" Margin="0,0,8,6">
                                        <TextBlock Text="{Binding StringFormat='{}{0:0} %'}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
                                        <ProgressBar Value="{Binding Mode=OneWay}" Maximum="100" Height="5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <ItemsControl ItemsSource="{Binding CpuRows}" ItemTemplate="{StaticResource PropertyRowTemplate}"/>
                </Border>
            </StackPanel>

            <!-- GPU -->
            <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=gpu}">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{i:Loc hw.live}" Style="{StaticResource Text.Section}"/>
                        <TextBlock Text="{Binding GpuLive}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8"/>
                        <i:SparkChart Values="{Binding GpuHistory}" Height="80" Stroke="{DynamicResource Brush.Chart2}" GridBrush="{DynamicResource Brush.Grid}" Capacity="120"/>
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding GpuBlocks}" ItemTemplate="{StaticResource TitledRowsTemplate}"/>
            </StackPanel>

            <!-- RAM -->
            <!-- Data reliability: provenance of every main value -->
            <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=quality}">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{i:Loc dq.title}" Style="{StaticResource Text.Section}" Margin="0"/>
                        <TextBlock Text="{i:Loc dq.subtitle}" Style="{StaticResource Text.Muted}" Margin="0,4,0,12"/>
                        <DataGrid ItemsSource="{Binding DataQuality}" AutomationProperties.Name="{i:Loc dq.title}" RowHeight="NaN" MinRowHeight="32">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{i:Loc dq.col.area}" Binding="{Binding Area}" Width="*"/>
                                <DataGridTextColumn Header="{i:Loc dq.col.field}" Binding="{Binding Field}" Width="2*"/>
                                <DataGridTemplateColumn Header="{i:Loc dq.col.confidence}" Width="1.4*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Badge}" Margin="0" HorizontalAlignment="Left" Background="{Binding LevelKey, Converter={StaticResource LevelBrush}, ConverterParameter=soft}">
                                                <TextBlock Style="{StaticResource Text.Badge}" Text="{Binding Confidence}" Foreground="{Binding LevelKey, Converter={StaticResource LevelBrush}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{i:Loc dq.col.source}" Binding="{Binding Source}" Width="2*"/>
                                <DataGridTemplateColumn Header="{i:Loc dq.col.note}" Width="3*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="0,6" Foreground="{DynamicResource Brush.TextMuted}"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=ram}">
                <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource Brush.Warning}" Visibility="{Binding ShowXmpGuide, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <i:Icon Glyph="{StaticResource Icon.Ram}" Width="18" Height="18" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,10,0"/>
                            <TextBlock Text="{i:Loc xmp.guide.title}" Style="{StaticResource Text.CardTitle}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding XmpGuide}" Style="{StaticResource Text.Body}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{i:Loc hw.live}" Style="{StaticResource Text.Section}"/>
                        <TextBlock Text="{Binding RamLive}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8"/>
                        <i:SparkChart Values="{Binding RamHistory}" Height="80" Stroke="{DynamicResource Brush.Chart3}" GridBrush="{DynamicResource Brush.Grid}" Capacity="120"/>
                        <TextBlock Text="{i:Loc ram.noCleaner}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding RamRows}" ItemTemplate="{StaticResource PropertyRowTemplate}"/>
                        <TextBlock Text="{i:Loc hw.ram.modules}" Style="{StaticResource Text.Section}" Margin="0,10,0,6"/>
                        <ItemsControl ItemsSource="{Binding RamModules}" ItemTemplate="{StaticResource PropertyRowTemplate}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{i:Loc ram.diag.title}" Style="{StaticResource Text.Section}"/>
                        <TextBlock Text="{i:Loc ram.diag.desc}" Style="{StaticResource Text.Muted}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{i:Loc ram.diag.launch}" Style="{StaticResource Button.Secondary}" Command="{Binding MemoryDiagnosticLaunchCommand}" Margin="0,0,8,0"/>
                            <Button Content="{i:Loc ram.diag.results}" Style="{StaticResource Button.Secondary}" Command="{Binding MemoryDiagnosticResultsCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding MemDiagResult}" Style="{StaticResource Text.Muted}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{i:Loc ram.top}" Style="{StaticResource Text.Section}"/>
                        <DataGrid ItemsSource="{Binding TopProcesses}" MaxHeight="420">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{i:Loc ram.col.process}" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="{i:Loc ram.col.count}" Binding="{Binding Count}" Width="70"/>
                                <DataGridTextColumn Header="{i:Loc ram.col.private}" Binding="{Binding PrivateBytes, Converter={StaticResource Bytes}}" Width="110"/>
                                <DataGridTextColumn Header="{i:Loc ram.col.ws}" Binding="{Binding WorkingSet, Converter={StaticResource Bytes}}" Width="110"/>
                                <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent, StringFormat='{}{0:0.0}'}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="{i:Loc ram.anomalies}" Style="{StaticResource Text.Caption}" Margin="0,10,0,4"/>
                        <ItemsControl ItemsSource="{Binding MemoryAnomalies}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Warning}"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Motherboard / BIOS -->
            <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=board}">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding BoardRows}" ItemTemplate="{StaticResource PropertyRowTemplate}"/>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{i:Loc bios.update.title}" Style="{StaticResource Text.Section}"/>
                        <TextBlock Text="{Binding BiosNote}" Style="{StaticResource Text.Body}"/>
                        <Button Content="{i:Loc bios.officialPage}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,10,0,10"
                                Command="{Binding OpenBiosPageCommand}" Visibility="{Binding BiosUrl, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{i:Loc bios.update.steps}" Style="{StaticResource Text.CardTitle}" Margin="0,6,0,4"/>
                        <ItemsControl ItemsSource="{Binding BiosSteps}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{i:Loc bios.update.risksLabel}" Style="{StaticResource Text.CardTitle}" Margin="0,10,0,4"/>
                        <ItemsControl ItemsSource="{Binding BiosRisks}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='⚠ {0}'}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Storage -->
            <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=storage}">
                <ItemsControl ItemsSource="{Binding StorageBlocks}" ItemTemplate="{StaticResource TitledRowsTemplate}"/>
            </StackPanel>

            <!-- Displays -->
            <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=display}">
                <ItemsControl ItemsSource="{Binding DisplayBlocks}" ItemTemplate="{StaticResource TitledRowsTemplate}"/>
                <Button Content="{i:Loc display.applyMax}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Command="{Binding ApplyMaxRefreshCommand}"/>
            </StackPanel>

            <!-- Network -->
            <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=network}">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{i:Loc net.test.title}" Style="{StaticResource Text.Section}"/>
                        <TextBlock Text="{i:Loc net.test.desc}" Style="{StaticResource Text.Muted}"/>
                        <Button Content="{i:Loc net.test.run}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left" Margin="0,10,0,8"
                                Command="{Binding TestLatencyCommand}" IsEnabled="{Binding LatencyRunning, Converter={StaticResource Not}}"/>
                        <TextBlock Text="{Binding LatencyResult}" Style="{StaticResource Text.Body}" FontFamily="{StaticResource Font.Mono}"/>
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding NetworkBlocks}" ItemTemplate="{StaticResource TitledRowsTemplate}"/>
            </StackPanel>

            <!-- Windows & security -->
            <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=windows}">
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <ItemsControl ItemsSource="{Binding WindowsRows}" ItemTemplate="{StaticResource PropertyRowTemplate}"/>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{i:Loc hw.security}" Style="{StaticResource Text.Section}"/>
                        <TextBlock Text="{i:Loc hw.security.note}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding SecurityRows}" ItemTemplate="{StaticResource PropertyRowTemplate}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Text="{i:Loc hw.findings}" Style="{StaticResource Text.Section}" Margin="0,18,0,10" Visibility="{Binding SectionFindings.Count, Converter={StaticResource BoolToVis}}"/>
            <ItemsControl ItemsSource="{Binding SectionFindings}" ItemTemplate="{StaticResource FindingTemplate}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
