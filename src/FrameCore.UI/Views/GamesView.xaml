<UserControl x:Class="FrameCore.UI.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:FrameCore.UI.Infrastructure">
    <UserControl.Resources>
        <!-- Showcase card: before → after, range, limiter, confidence, origin of the number -->
        <DataTemplate x:Key="ShowcaseCard">
            <Border Style="{StaticResource Card.Interactive}" Margin="0,0,12,12" Padding="18" Cursor="Hand" i:Motion.Enter="1">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SettingsText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{i:Loc games.before}" Style="{StaticResource Text.Overline}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Text.Metric}" i:Motion.CountFormat="0" i:Motion.CountTo="{Binding FpsValue}"/>
                                <TextBlock Text="{i:Loc unit.fps}" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" Margin="4,0,0,6"/>
                            </StackPanel>
                            <TextBlock Text="{Binding RangeText}" Style="{StaticResource Text.Caption}"/>
                        </StackPanel>
                        <i:Icon Grid.Column="1" Glyph="{StaticResource Icon.ArrowRight}" Width="18" Height="18" Margin="10,22,10,0" VerticalAlignment="Top" Foreground="{DynamicResource Brush.TextFaint}"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{i:Loc games.after}" Style="{StaticResource Text.Overline}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding AfterText}" Style="{StaticResource Text.Metric}" Foreground="{DynamicResource Brush.AccentText}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding GainText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.AccentText}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,14,0,0">
                        <Border Style="{StaticResource Badge}"><TextBlock Style="{StaticResource Text.Badge}" Text="{Binding LimiterText}"/></Border>
                        <Border Style="{StaticResource Badge}" Background="{Binding ConfidenceKey, Converter={StaticResource LevelBrush}, ConverterParameter=soft}">
                            <TextBlock Style="{StaticResource Text.Badge}" Text="{Binding ConfidenceText}" Foreground="{Binding ConfidenceKey, Converter={StaticResource LevelBrush}}"/>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding BasisText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding GainReason}" Style="{StaticResource Text.Muted}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Pad.Page}">
            <!-- Header -->
            <DockPanel Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{i:Loc games.title}" Style="{StaticResource Text.PageTitle}"/>
                    <TextBlock Text="{i:Loc games.subtitle}" Style="{StaticResource Text.Subtitle}" MaxWidth="820" HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding MachineText}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Settings used for every estimate -->
            <Border Style="{StaticResource Card}" Padding="{StaticResource Pad.CardCompact}">
                <WrapPanel>
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock Text="{i:Loc games.resolution}" Style="{StaticResource Text.Overline}" Margin="0,0,0,6"/>
                        <ItemsControl ItemsSource="{Binding Resolutions}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource Segment}" Content="{Binding}" GroupName="res"
                                                 Command="{Binding DataContext.SetResolutionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <RadioButton.IsChecked>
                                            <MultiBinding Mode="OneWay">
                                                <MultiBinding.Converter><i:MultiEqualsConverter/></MultiBinding.Converter>
                                                <Binding/>
                                                <Binding Path="DataContext.Resolution" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </RadioButton.IsChecked>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{i:Loc games.preset}" Style="{StaticResource Text.Overline}" Margin="0,0,0,6"/>
                        <WrapPanel>
                            <RadioButton Style="{StaticResource Segment}" Content="{i:Loc preset.auto}" IsChecked="{Binding Preset, Converter={StaticResource Eq}, ConverterParameter=auto}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="{i:Loc preset.Low}" IsChecked="{Binding Preset, Converter={StaticResource Eq}, ConverterParameter=Low}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="{i:Loc preset.Medium}" IsChecked="{Binding Preset, Converter={StaticResource Eq}, ConverterParameter=Medium}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="{i:Loc preset.High}" IsChecked="{Binding Preset, Converter={StaticResource Eq}, ConverterParameter=High}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="{i:Loc preset.Ultra}" IsChecked="{Binding Preset, Converter={StaticResource Eq}, ConverterParameter=Ultra}"/>
                        </WrapPanel>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <!-- Loading -->
            <Border Style="{StaticResource Card}" Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{i:Loc games.loading}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8"/>
                    <ProgressBar IsIndeterminate="True"/>
                </StackPanel>
            </Border>

            <!-- No identified graphics card: explain instead of showing empty numbers -->
            <Border Style="{StaticResource Banner}" BorderBrush="{DynamicResource Brush.Warning}" Background="{DynamicResource Brush.WarningSoft}"
                    Visibility="{Binding HasEstimates, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <TextBlock Text="{i:Loc games.noEstimates}" Style="{StaticResource Text.Body}"/>
            </Border>

            <!-- Showcase -->
            <DockPanel Margin="0,8,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Command="{Binding ToggleExplorerCommand}">
                    <StackPanel Orientation="Horizontal">
                        <i:Icon Glyph="{StaticResource Icon.List}" Width="15" Height="15" Foreground="{DynamicResource Brush.Text}" Margin="0,0,8,0"/>
                        <TextBlock>
                            <Run Text="{i:Loc games.explore}"/> <Run Text="{Binding Count, Mode=OneWay}"/> <Run Text="{i:Loc games.gamesWord}"/>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="{i:Loc games.showcase}" Style="{StaticResource Text.Section}" Margin="0"/>
                    <TextBlock Text="{Binding GainSourceText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Showcase}" ItemTemplate="{StaticResource ShowcaseCard}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
            <Border Style="{StaticResource Banner}" Margin="0,0,0,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Small}" Content="{i:Loc games.goBench}" Command="{Binding GoBenchmarkCommand}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock Text="{i:Loc games.howGain}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Explorer -->
            <Grid Visibility="{Binding ShowExplorer, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <i:Icon DockPanel.Dock="Left" Glyph="{StaticResource Icon.Search}" Width="16" Height="16" Foreground="{DynamicResource Brush.TextFaint}" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{i:Loc games.search}" Tag="{i:Loc games.searchHint}"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding GenreChoices}" Margin="0,0,0,4">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource Segment}" Content="{Binding Label}" GroupName="genre"
                                                 Command="{Binding DataContext.SetGenreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}">
                                        <RadioButton.IsChecked>
                                            <MultiBinding Mode="OneWay">
                                                <MultiBinding.Converter><i:MultiEqualsConverter/></MultiBinding.Converter>
                                                <Binding Path="Key"/>
                                                <Binding Path="DataContext.Genre" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </RadioButton.IsChecked>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Margin="0,0,0,10">
                            <TextBlock Text="{i:Loc games.sort}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <RadioButton Style="{StaticResource Segment}" Content="{i:Loc games.sort.popularity}" IsChecked="{Binding Sort, Converter={StaticResource Eq}, ConverterParameter=popularity}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="{i:Loc games.sort.fpsDesc}" IsChecked="{Binding Sort, Converter={StaticResource Eq}, ConverterParameter=fpsDesc}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="{i:Loc games.sort.fpsAsc}" IsChecked="{Binding Sort, Converter={StaticResource Eq}, ConverterParameter=fpsAsc}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="{i:Loc games.sort.gain}" IsChecked="{Binding Sort, Converter={StaticResource Eq}, ConverterParameter=gain}"/>
                            <RadioButton Style="{StaticResource Segment}" Content="{i:Loc games.sort.name}" IsChecked="{Binding Sort, Converter={StaticResource Eq}, ConverterParameter=name}"/>
                        </WrapPanel>
                        <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Style="{StaticResource List.Plain}" ItemContainerStyle="{StaticResource ListItem.Selectable}"
                                 MaxHeight="640" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                                 AutomationProperties.Name="{i:Loc games.title}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="Auto" MinWidth="70"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Style="{StaticResource Text.Caption}">
                                                <Run Text="{Binding Genre, Mode=OneWay}"/> · <Run Text="{Binding PresetText, Mode=OneWay}"/> · <Run Text="{Binding LimiterText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                            <Border Height="6" CornerRadius="3" Background="{DynamicResource Brush.Inset}">
                                                <Border HorizontalAlignment="Stretch" CornerRadius="3" Background="{DynamicResource Brush.Accent}" i:Motion.Fraction="{Binding BarFraction}"/>
                                            </Border>
                                            <TextBlock Text="{Binding RangeText}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource Font.Display}" FontSize="17" FontWeight="SemiBold" Text="{Binding FpsText}"/>
                                            <TextBlock HorizontalAlignment="Right" Text="{Binding ConfidenceText}" Style="{StaticResource Text.Caption}" TextWrapping="NoWrap" Foreground="{Binding ConfidenceKey, Converter={StaticResource LevelBrush}}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Detail -->
                <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <Grid>
                        <TextBlock Text="{i:Loc games.pick}" Style="{StaticResource Text.Muted}"
                                   Visibility="{Binding Selected, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                        <StackPanel DataContext="{Binding Selected}" Visibility="{Binding Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Section}" Margin="0"/>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,12">
                                <Run Text="{Binding Genre, Mode=OneWay}"/> · <Run Text="{Binding Engine, Mode=OneWay}"/> · <Run Text="{Binding Game.Api, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding SettingsText}" Style="{StaticResource Text.Muted}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{Binding FpsText}" Style="{StaticResource Text.Display}"/>
                                <TextBlock Text="{i:Loc unit.fps}" Style="{StaticResource Text.Muted}" VerticalAlignment="Bottom" Margin="6,0,0,6"/>
                            </StackPanel>
                            <TextBlock Text="{Binding RangeText}" Style="{StaticResource Text.Muted}"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Border Style="{StaticResource Badge}"><TextBlock Style="{StaticResource Text.Badge}" Text="{Binding LimiterText}"/></Border>
                                <Border Style="{StaticResource Badge}" Background="{Binding ConfidenceKey, Converter={StaticResource LevelBrush}, ConverterParameter=soft}">
                                    <TextBlock Style="{StaticResource Text.Badge}" Text="{Binding ConfidenceText}" Foreground="{Binding ConfidenceKey, Converter={StaticResource LevelBrush}}"/>
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="{Binding BasisText}" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Text="{Binding CpuGpuText}" Style="{StaticResource Text.Muted}" Margin="0,8,0,0"/>
                            <Border Style="{StaticResource Divider}"/>
                            <TextBlock Text="{i:Loc games.afterOptimisation}" Style="{StaticResource Text.Overline}"/>
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Body}">
                                <Run Text="{Binding AfterText, Mode=OneWay}" FontWeight="SemiBold"/> <Run Text="{i:Loc unit.fps}"/> · <Run Text="{Binding GainText, Mode=OneWay}"/> <Run Text="{Binding GainAbsText, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding GainRangeText}" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Text="{Binding GainReason}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Notes}" Style="{StaticResource Text.Muted}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Text="{Binding Provenance}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding ExcludedText}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
