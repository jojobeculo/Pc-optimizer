<UserControl x:Class="FrameCore.UI.Views.OptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:FrameCore.UI.Infrastructure">
    <UserControl.Resources>
        <Style x:Key="LevelCard" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1.5"
                                CornerRadius="{StaticResource Radius.Card}" Padding="20,18">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.CardHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.CardHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="StepSegment">
            <StackPanel Margin="0,0,6,0">
                <Border Height="6" CornerRadius="3" Background="{DynamicResource Brush.Inset}" ClipToBounds="True">
                    <Border CornerRadius="3" Background="{DynamicResource Brush.Accent}" i:Motion.Fraction="{Binding Fraction}"/>
                </Border>
                <TextBlock x:Name="Label" Text="{Binding Title}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="active"><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text}"/></DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="done"><Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.AccentText}"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Pad.Page}">
            <TextBlock Text="{i:Loc opt.title}" Style="{StaticResource Text.PageTitle}"/>
            <TextBlock Text="{i:Loc opt.subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,18" MaxWidth="820" HorizontalAlignment="Left"/>

            <!-- Three levels -->
            <UniformGrid Columns="3">
                <RadioButton Style="{StaticResource LevelCard}" GroupName="level" Command="{Binding PrepareCommand}" CommandParameter="Balanced"
                             IsChecked="{Binding SelectedProfile, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Balanced}" i:Motion.Enter="0">
                    <StackPanel>
                        <i:Icon Glyph="{StaticResource Icon.Shield}" Width="22" Height="22" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{i:Loc profile.Balanced}" Style="{StaticResource Text.CardTitle}" FontSize="17" Margin="0,10,0,4"/>
                        <TextBlock Text="{i:Loc profile.Balanced.desc}" Style="{StaticResource Text.Muted}" MinHeight="54"/>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0">
                            <Run Text="{Binding BalancedCount, Mode=OneWay}" FontWeight="SemiBold"/> <Run Text="{i:Loc opt.changesProposed}"/>
                        </TextBlock>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource LevelCard}" GroupName="level" Command="{Binding PrepareCommand}" CommandParameter="Performance"
                             IsChecked="{Binding SelectedProfile, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Performance}" i:Motion.Enter="1">
                    <StackPanel>
                        <i:Icon Glyph="{StaticResource Icon.Gauge}" Width="22" Height="22" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{i:Loc profile.Performance}" Style="{StaticResource Text.CardTitle}" FontSize="17" Margin="0,10,0,4"/>
                        <TextBlock Text="{i:Loc profile.Performance.desc}" Style="{StaticResource Text.Muted}" MinHeight="54"/>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0">
                            <Run Text="{Binding PerformanceCount, Mode=OneWay}" FontWeight="SemiBold"/> <Run Text="{i:Loc opt.changesProposed}"/>
                        </TextBlock>
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource LevelCard}" GroupName="level" Command="{Binding PrepareCommand}" CommandParameter="Maximum" Margin="0,0,0,12"
                             IsChecked="{Binding SelectedProfile, Mode=OneWay, Converter={StaticResource Eq}, ConverterParameter=Maximum}" i:Motion.Enter="2">
                    <StackPanel>
                        <i:Icon Glyph="{StaticResource Icon.Rocket}" Width="22" Height="22" Foreground="{DynamicResource Brush.Warning}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{i:Loc profile.Maximum}" Style="{StaticResource Text.CardTitle}" FontSize="17" Margin="0,10,0,4"/>
                        <TextBlock Text="{i:Loc profile.Maximum.desc}" Style="{StaticResource Text.Muted}" MinHeight="54"/>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0">
                            <Run Text="{Binding MaximumCount, Mode=OneWay}" FontWeight="SemiBold"/> <Run Text="{i:Loc opt.changesProposedMax}"/>
                        </TextBlock>
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <Border Style="{StaticResource Banner}" Margin="0,0,0,18">
                <DockPanel>
                    <i:Icon DockPanel.Dock="Left" Glyph="{StaticResource Icon.Shield}" Width="16" Height="16" Foreground="{DynamicResource Brush.Info}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                    <TextBlock Text="{i:Loc opt.safety}" Style="{StaticResource Text.Body}"/>
                </DockPanel>
            </Border>
            <TextBlock Text="{i:Loc opt.pickLevel}" Style="{StaticResource Text.Muted}" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>

            <!-- Plan -->
            <StackPanel Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{i:Loc opt.applyShort}" Style="{StaticResource Button.SmallPrimary}" Command="{Binding ApplyCommand}" Margin="0,0,12,0"
                                IsEnabled="{Binding ApplyRunning, Converter={StaticResource Not}}" ToolTip="{i:Loc opt.applyShort.tip}"/>
                        <Button Content="{i:Loc opt.selectAll}" Style="{StaticResource Button.Small}" Command="{Binding SelectAllCommand}" Margin="0,0,6,0"/>
                        <Button Content="{i:Loc opt.selectNone}" Style="{StaticResource Button.Small}" Command="{Binding SelectNoneCommand}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Section}" Margin="0">
                        <Run Text="{i:Loc opt.planFor}"/> <Run Text="{Binding SelectedProfile, Mode=OneWay, Converter={StaticResource LocKey}, ConverterParameter=profile.}"/>
                    </TextBlock>
                </DockPanel>
                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,0,0,10">
                    <Run Text="{Binding AlreadyApplied, Mode=OneWay}"/> <Run Text="{i:Loc opt.alreadyApplied}"/>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Standard}" ItemTemplate="{StaticResource PlanItemTemplate}"/>

                <StackPanel Visibility="{Binding StartupSuggestions.Count, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                    <TextBlock Text="{i:Loc opt.startup.title}" Style="{StaticResource Text.Section}"/>
                    <TextBlock Text="{i:Loc opt.startup.desc}" Style="{StaticResource Text.Muted}" Margin="0,0,0,4"/>
                    <TextBlock Text="{i:Loc opt.startup.updatersNote}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding StartupSuggestions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,10,0" AutomationProperties.Name="{Binding Name}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}"/>
                                            <TextBlock Style="{StaticResource Text.Muted}">
                                                <Run Text="{Binding Publisher, Mode=OneWay}"/> · <Run Text="{Binding Reason, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{Binding Consent.Count, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                    <TextBlock Text="{i:Loc opt.consent.title}" Style="{StaticResource Text.Section}"/>
                    <TextBlock Text="{i:Loc opt.consent.desc}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Consent}" ItemTemplate="{StaticResource PlanItemTemplate}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding Experimental.Count, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                    <TextBlock Text="{i:Loc opt.experimental.title}" Style="{StaticResource Text.Section}"/>
                    <Border Style="{StaticResource Banner}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{i:Loc opt.experimental.desc}" Style="{StaticResource Text.Body}"/>
                            <CheckBox Content="{i:Loc opt.experimental.ack}" IsChecked="{Binding ExperimentalAcknowledged}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Experimental}" ItemTemplate="{StaticResource PlanItemTemplate}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding Guidance.Count, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                    <TextBlock Text="{i:Loc opt.guidance.title}" Style="{StaticResource Text.Section}"/>
                    <TextBlock Text="{i:Loc opt.guidance.desc}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Guidance}" ItemTemplate="{StaticResource FindingTemplate}"/>
                </StackPanel>

                <Expander Header="{i:Loc opt.excluded}" Margin="0,10,0,0" Visibility="{Binding Excluded.Count, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Excluded}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Inset}" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}"/>
                                        <TextBlock Text="{Binding Compatibility}" Style="{StaticResource Text.Muted}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <Border x:Name="ApplyCard" Style="{StaticResource Card.Hero}" Margin="0,18,0,12">
                    <StackPanel>
                        <TextBlock Text="{i:Loc opt.apply.title}" Style="{StaticResource Text.Section}"/>
                        <CheckBox Style="{StaticResource Toggle}" Content="{i:Loc opt.restorePoint}" IsChecked="{Binding CreateRestorePoint}" IsEnabled="{Binding ApplyRunning, Converter={StaticResource Not}}"/>
                        <TextBlock Text="{i:Loc opt.restorePointNote}" Style="{StaticResource Text.Caption}" Margin="48,4,0,10"/>
                        <CheckBox Style="{StaticResource Toggle}" Content="{i:Loc opt.measure}" IsChecked="{Binding MeasureBeforeAfter}" IsEnabled="{Binding ApplyRunning, Converter={StaticResource Not}}"/>
                        <TextBlock Text="{i:Loc opt.measureNote}" Style="{StaticResource Text.Caption}" Margin="48,4,0,0"/>
                        <TextBlock Text="{i:Loc opt.elevationNote}" Style="{StaticResource Text.Caption}" Margin="48,6,0,0" Visibility="{Binding NeedsElevation, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,16,0,0" Command="{Binding ApplyCommand}"
                                IsEnabled="{Binding ApplyRunning, Converter={StaticResource Not}}" MinWidth="220">
                            <StackPanel Orientation="Horizontal">
                                <i:Icon Glyph="{StaticResource Icon.Optimize}" Width="15" Height="15" Foreground="{DynamicResource Brush.OnAccent}" Margin="0,0,8,0"/>
                                <TextBlock Text="{i:Loc opt.apply}"/>
                            </StackPanel>
                        </Button>

                        <!-- Real, step-by-step progress -->
                        <StackPanel Margin="0,18,0,0" Visibility="{Binding ApplyRunning, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding CurrentStep}" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepSegment}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" Visibility="{Binding CurrentStepIndeterminate, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Outcome: what changed, what was verified, measured effect, and three games -->
                <Border x:Name="OutcomeCard" Style="{StaticResource Card}" Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVis}}" i:Motion.Enter="0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <i:Icon Glyph="{StaticResource Icon.CheckCircle}" Width="20" Height="20" Foreground="{DynamicResource Brush.Success}" Margin="0,0,10,0"/>
                            <TextBlock Text="{i:Loc opt.outcome}" Style="{StaticResource Text.Section}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ResultText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
                        <!-- Administrator rights refused: say clearly what was not applied and how to finish -->
                        <Border Style="{StaticResource Banner}" Margin="0,10,0,4" Visibility="{Binding RightsWarning, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.SmallPrimary}" Content="{i:Loc opt.rightsRetry}" Command="{Binding ApplyCommand}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBlock Text="{Binding RightsWarning}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warning}"/>
                            </DockPanel>
                        </Border>
                        <TextBlock Text="{Binding MeasurementText}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding MeasurementText, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding VerificationText}" Style="{StaticResource Text.Body}" Margin="0,6,0,0" Foreground="{DynamicResource Brush.AccentText}"/>
                        <ItemsControl ItemsSource="{Binding VerificationLines}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Text.Muted}"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding PerformanceText}" Style="{StaticResource Text.Body}" Margin="0,6,0,0" Visibility="{Binding PerformanceText, Converter={StaticResource BoolToVis}}"/>
                        <Expander Header="{i:Loc opt.outcome.details}" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding ResultLines}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Text.Muted}"/></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </Border>
                <StackPanel Visibility="{Binding HasOutcome, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="0,10,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Small}" Content="{i:Loc opt.seeAllGames}"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="games"/>
                        <TextBlock Text="{i:Loc games.showcase}" Style="{StaticResource Text.Section}" Margin="0"/>
                    </DockPanel>
                    <TextBlock Text="{i:Loc games.howGain}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Games.Showcase}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SettingsText}" Style="{StaticResource Text.Caption}"/>
                                        <!-- "before → after" only when a change was measured -->
                                        <TextBlock Margin="0,10,0,0" Visibility="{Binding HasMeasuredChange, Converter={StaticResource BoolToVis}}">
                                            <Run Text="{Binding FpsText, Mode=OneWay}" FontFamily="{StaticResource Font.Display}" FontSize="22" FontWeight="SemiBold"/>
                                            <Run Text=" → " Foreground="{DynamicResource Brush.TextFaint}"/>
                                            <Run Text="{Binding AfterText, Mode=OneWay}" FontFamily="{StaticResource Font.Display}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}"/>
                                            <Run Text="{i:Loc unit.fps}" Foreground="{DynamicResource Brush.TextFaint}"/>
                                        </TextBlock>
                                        <TextBlock Margin="0,10,0,0" Visibility="{Binding HasMeasuredChange, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                            <Run Text="{Binding FpsText, Mode=OneWay}" FontFamily="{StaticResource Font.Display}" FontSize="22" FontWeight="SemiBold"/>
                                            <Run Text="{i:Loc unit.fps}" Foreground="{DynamicResource Brush.TextFaint}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding GainText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Brush.AccentText}" Visibility="{Binding HasMeasuredChange, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding GainText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                                                   Visibility="{Binding HasMeasuredChange, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                        <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{Binding LimiterText, Mode=OneWay}"/> · <Run Text="{Binding ConfidenceText, Mode=OneWay}"/></TextBlock>
                                        <TextBlock Text="{Binding GainReason}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <Button Style="{StaticResource Button.Small}" Content="{i:Loc games.measureInGame}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                Command="{Binding DataContext.Games.MeasureInGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
