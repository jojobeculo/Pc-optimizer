<UserControl x:Class="FrameCore.UI.Views.OptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:FrameCore.UI.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,4,28,28">
        <StackPanel>
            <TextBlock Text="{i:Loc opt.title}" Style="{StaticResource Text.PageTitle}"/>
            <TextBlock Text="{i:Loc opt.subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,2,0,18"/>

            <UniformGrid Columns="3" Margin="-7,0,-7,18">
                <Border Style="{StaticResource Card}" Margin="7">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="{i:Loc opt.prepare}" Style="{StaticResource Button.Primary}" Margin="0,14,0,0"
                                Command="{Binding PrepareCommand}" CommandParameter="Light"/>
                        <StackPanel>
                            <TextBlock Text="&#xE945;" Style="{StaticResource Text.Icon}" FontSize="22" Foreground="{DynamicResource Brush.Success}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{i:Loc profile.Light}" Style="{StaticResource Text.Section}" Margin="0,8,0,4"/>
                            <TextBlock Text="{i:Loc opt.light.desc}" Style="{StaticResource Text.Muted}"/>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0">
                                <Run Text="{Binding LightCount, Mode=OneWay}"/> <Run Text="{i:Loc opt.changesProposed}"/>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="7">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="{i:Loc opt.prepare}" Style="{StaticResource Button.Primary}" Margin="0,14,0,0"
                                Command="{Binding PrepareCommand}" CommandParameter="Balanced"/>
                        <StackPanel>
                            <TextBlock Text="&#xE9F5;" Style="{StaticResource Text.Icon}" FontSize="22" Foreground="{DynamicResource Brush.Accent2}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{i:Loc profile.Balanced}" Style="{StaticResource Text.Section}" Margin="0,8,0,4"/>
                            <TextBlock Text="{i:Loc opt.balanced.desc}" Style="{StaticResource Text.Muted}"/>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0">
                                <Run Text="{Binding BalancedCount, Mode=OneWay}"/> <Run Text="{i:Loc opt.changesProposed}"/>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="7">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="{i:Loc opt.prepare}" Style="{StaticResource Button.Primary}" Margin="0,14,0,0"
                                Command="{Binding PrepareCommand}" CommandParameter="Maximum"/>
                        <StackPanel>
                            <TextBlock Text="&#xEC4A;" Style="{StaticResource Text.Icon}" FontSize="22" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Left"/>
                            <TextBlock Text="{i:Loc profile.Maximum}" Style="{StaticResource Text.Section}" Margin="0,8,0,4"/>
                            <TextBlock Text="{i:Loc opt.maximum.desc}" Style="{StaticResource Text.Muted}"/>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0">
                                <Run Text="{Binding MaximumCount, Mode=OneWay}"/> <Run Text="{i:Loc opt.changesProposedMax}"/>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Banner}" Background="{DynamicResource Brush.InfoSoft}" BorderBrush="{DynamicResource Brush.Info}" Margin="0,0,0,18">
                <TextBlock Text="{i:Loc opt.safety}" Style="{StaticResource Text.Body}"/>
            </Border>

            <!-- Plan -->
            <StackPanel Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
                <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{i:Loc opt.selectAll}" Style="{StaticResource Button.Small}" Command="{Binding SelectAllCommand}" Margin="0,0,6,0"/>
                        <Button Content="{i:Loc opt.selectNone}" Style="{StaticResource Button.Small}" Command="{Binding SelectNoneCommand}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Section}" Margin="0">
                        <Run Text="{i:Loc opt.planFor}"/> <Run Text="{Binding SelectedProfile, Mode=OneWay, Converter={StaticResource LocKey}, ConverterParameter=profile.}"/>
                    </TextBlock>
                </DockPanel>
                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,0,0,10">
                    <Run Text="{Binding AlreadyApplied, Mode=OneWay}"/> <Run Text="{i:Loc opt.alreadyApplied}"/>
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Standard}" ItemTemplate="{StaticResource PlanItemTemplate}"/>

                <StackPanel Visibility="{Binding StartupSuggestions.Count, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                    <TextBlock Text="{i:Loc opt.startup.title}" Style="{StaticResource Text.Section}"/>
                    <TextBlock Text="{i:Loc opt.startup.desc}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding StartupSuggestions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}"/>
                                            <TextBlock Style="{StaticResource Text.Muted}">
                                                <Run Text="{Binding Publisher, Mode=OneWay}"/> · <Run Text="{Binding Reason, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Visibility="{Binding Consent.Count, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                    <TextBlock Text="{i:Loc opt.consent.title}" Style="{StaticResource Text.Section}"/>
                    <TextBlock Text="{i:Loc opt.consent.desc}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Consent}" ItemTemplate="{StaticResource PlanItemTemplate}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding Experimental.Count, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                    <TextBlock Text="{i:Loc opt.experimental.title}" Style="{StaticResource Text.Section}"/>
                    <Border Style="{StaticResource Banner}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{i:Loc opt.experimental.desc}" Style="{StaticResource Text.Body}"/>
                            <CheckBox Content="{i:Loc opt.experimental.ack}" IsChecked="{Binding ExperimentalAcknowledged}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Experimental}" ItemTemplate="{StaticResource PlanItemTemplate}"/>
                </StackPanel>

                <StackPanel Visibility="{Binding Guidance.Count, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                    <TextBlock Text="{i:Loc opt.guidance.title}" Style="{StaticResource Text.Section}"/>
                    <TextBlock Text="{i:Loc opt.guidance.desc}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Guidance}" ItemTemplate="{StaticResource FindingTemplate}"/>
                </StackPanel>

                <Expander Header="{i:Loc opt.excluded}" Margin="0,10,0,0" Visibility="{Binding Excluded.Count, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Excluded}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Inset}" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}"/>
                                        <TextBlock Text="{Binding Compatibility}" Style="{StaticResource Text.Muted}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <StackPanel>
                        <CheckBox Style="{StaticResource Toggle}" Content="{i:Loc opt.restorePoint}" IsChecked="{Binding CreateRestorePoint}"/>
                        <TextBlock Text="{i:Loc opt.restorePointNote}" Style="{StaticResource Text.Caption}" Margin="50,4,0,0"/>
                        <TextBlock Text="{i:Loc opt.elevationNote}" Style="{StaticResource Text.Caption}" Margin="50,4,0,0" Visibility="{Binding NeedsElevation, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="{i:Loc opt.apply}" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Margin="0,14,0,0" Command="{Binding ApplyCommand}"/>
                        <TextBlock Text="{Binding ResultText}" Style="{StaticResource Text.Body}" Margin="0,12,0,0" Visibility="{Binding ResultText, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding ResultLines}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Text.Muted}"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
