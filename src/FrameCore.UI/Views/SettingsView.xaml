<UserControl x:Class="FrameCore.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:FrameCore.UI.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,4,28,28">
        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="{i:Loc settings.title}" Style="{StaticResource Text.PageTitle}"/>
            <TextBlock Text="{i:Loc settings.subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,2,0,16"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{i:Loc settings.appearance}" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8"/>
                    <TextBlock Text="{i:Loc settings.language}" Style="{StaticResource Text.Caption}"/>
                    <WrapPanel Margin="0,4,0,8">
                        <RadioButton Style="{StaticResource Segment}" Content="Français" IsChecked="{Binding Language, Converter={StaticResource Eq}, ConverterParameter=fr}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="English" IsChecked="{Binding Language, Converter={StaticResource Eq}, ConverterParameter=en}"/>
                    </WrapPanel>
                    <TextBlock Text="{i:Loc settings.theme}" Style="{StaticResource Text.Caption}"/>
                    <WrapPanel Margin="0,4,0,0">
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc settings.theme.dark}" IsChecked="{Binding Theme, Converter={StaticResource Eq}, ConverterParameter=Dark}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc settings.theme.light}" IsChecked="{Binding Theme, Converter={StaticResource Eq}, ConverterParameter=Light}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{i:Loc settings.safety}" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,8"/>
                    <CheckBox Style="{StaticResource Toggle}" Content="{i:Loc settings.restorePoint}" IsChecked="{Binding CreateRestorePoint}"/>
                    <TextBlock Text="{i:Loc settings.restorePoint.note}" Style="{StaticResource Text.Caption}" Margin="50,4,0,10"/>
                    <CheckBox Style="{StaticResource Toggle}" Content="{i:Loc settings.sensors}" IsChecked="{Binding AdvancedSensors}"/>
                    <TextBlock Text="{i:Loc settings.sensors.note}" Style="{StaticResource Text.Caption}" Margin="50,4,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="50,0,0,0">
                        <TextBlock Text="{Binding PawnIoStatus}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"/>
                        <Button Content="PawnIO" Style="{StaticResource Button.Ghost}" Command="{Binding OpenPawnIoCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{i:Loc settings.presentmon}" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,4"/>
                    <TextBlock Text="{i:Loc settings.presentmon.desc}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{i:Loc settings.validate}" Style="{StaticResource Button.Secondary}" Command="{Binding ValidatePresentMonCommand}" Margin="8,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="{i:Loc settings.browse}" Style="{StaticResource Button.Secondary}" Command="{Binding BrowsePresentMonCommand}" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding PresentMonPath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding PresentMonStatus}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                    <Button Content="{i:Loc bench.pm.page}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Command="{Binding OpenPresentMonCommand}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{i:Loc settings.report}" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,4"/>
                    <TextBlock Text="{i:Loc settings.report.desc}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8"/>
                    <CheckBox Style="{StaticResource Toggle}" Content="{i:Loc settings.anonymize}" IsChecked="{Binding AnonymizeReports}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{i:Loc settings.report.html}" Style="{StaticResource Button.Primary}" Command="{Binding ExportReportCommand}" CommandParameter="html" Margin="0,0,8,0"/>
                        <Button Content="{i:Loc settings.report.json}" Style="{StaticResource Button.Secondary}" Command="{Binding ExportReportCommand}" CommandParameter="json"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ReportStatus}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{i:Loc settings.updates}" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,4"/>
                    <TextBlock Text="{i:Loc settings.updates.desc}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8"/>
                    <CheckBox Style="{StaticResource Toggle}" Content="{i:Loc settings.updates.enable}" IsChecked="{Binding CheckForUpdates}" Margin="0,0,0,8"/>
                    <DockPanel IsEnabled="{Binding CheckForUpdates}">
                        <Button DockPanel.Dock="Right" Content="{i:Loc settings.updates.check}" Style="{StaticResource Button.Secondary}" Command="{Binding CheckUpdatesCommand}" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding UpdateUrl, UpdateSourceTrigger=LostFocus}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{i:Loc settings.about}" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Text.Body}">
                        <Run Text="FrameCore"/> <Run Text="{Binding Version, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{i:Loc settings.privacy}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                    <TextBlock Text="{i:Loc settings.unsigned}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"/>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0">
                        <Run Text="{i:Loc settings.dataFolder}"/> <Run Text="{Binding DataFolder, Mode=OneWay}"/>
                    </TextBlock>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="{i:Loc settings.openData}" Style="{StaticResource Button.Small}" Command="{Binding OpenDataCommand}" Margin="0,0,8,8"/>
                        <Button Content="{i:Loc settings.openLogs}" Style="{StaticResource Button.Small}" Command="{Binding OpenLogsCommand}" Margin="0,0,8,8"/>
                        <Button Content="{i:Loc settings.openDocs}" Style="{StaticResource Button.Small}" Command="{Binding OpenDocsCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
