<UserControl x:Class="FrameCore.UI.Views.ProModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:FrameCore.UI.Infrastructure">
    <Grid Margin="32,24,32,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
            <TextBlock Text="{i:Loc pro.title}" Style="{StaticResource Text.PageTitle}"/>
            <TextBlock Text="{i:Loc pro.subtitle}" Style="{StaticResource Text.Subtitle}"/>
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Categories}" SelectedValuePath="Key" SelectedValue="{Binding SelectedCategory}"
                 Style="{StaticResource List.Plain}" ItemContainerStyle="{StaticResource ListItem.Selectable}" Margin="0,0,0,20">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <i:Icon Glyph="{Binding Glyph}" Width="16" Height="16" Foreground="{DynamicResource Brush.TextMuted}"/>
                        <TextBlock Text="{Binding Label}" Margin="10,0,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,28">
            <StackPanel>
                <!-- Catalog settings of the category -->
                <StackPanel Visibility="{Binding IsCatalogCategory, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{i:Loc pro.catalogNote}" Style="{StaticResource Text.Muted}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource TweakCardTemplate}"/>
                    <TextBlock Text="{i:Loc pro.empty}" Style="{StaticResource Text.Muted}" Visibility="{Binding Rows.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                </StackPanel>

                <!-- Third-party services -->
                <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqVis}, ConverterParameter=Services}" Margin="0,10,0,0">
                    <TextBlock Text="{i:Loc pro.services.third}" Style="{StaticResource Text.Section}"/>
                    <TextBlock Text="{i:Loc pro.services.note}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding ServiceRows}" MaxHeight="600">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{i:Loc startup.col.name}" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="{i:Loc startup.col.publisher}" Binding="{Binding Publisher}" Width="*"/>
                            <DataGridTextColumn Header="{i:Loc startup.col.startType}" Binding="{Binding StartType}" Width="120"/>
                            <DataGridTemplateColumn Header="{i:Loc startup.col.class}" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Badge}" Background="{Binding Classification, Converter={StaticResource LevelBrush}, ConverterParameter=soft}" ToolTip="{Binding Reason}">
                                            <TextBlock Style="{StaticResource Text.Badge}" Text="{Binding ClassificationLabel}" Foreground="{Binding Classification, Converter={StaticResource LevelBrush}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanToggle}">
                                            <Button Content="{i:Loc startup.manual}" Style="{StaticResource Button.Small}" Command="{Binding DisableCommand}" Margin="0,0,4,0"/>
                                            <Button Content="{i:Loc startup.automatic}" Style="{StaticResource Button.Small}" Command="{Binding EnableCommand}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!-- Startup -->
                <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqVis}, ConverterParameter=Startup}">
                    <TextBlock Text="{i:Loc pro.startup.title}" Style="{StaticResource Text.Section}"/>
                    <TextBlock Text="{i:Loc pro.startup.desc}" Style="{StaticResource Text.Muted}" Margin="0,0,0,8"/>
                    <WrapPanel Margin="0,0,0,8">
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc startup.filter.All}" IsChecked="{Binding StartupFilter, Converter={StaticResource Eq}, ConverterParameter=All}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc startup.kind.RunKey}" IsChecked="{Binding StartupFilter, Converter={StaticResource Eq}, ConverterParameter=RunKey}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc startup.kind.StartupFolder}" IsChecked="{Binding StartupFilter, Converter={StaticResource Eq}, ConverterParameter=StartupFolder}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc startup.kind.ScheduledTask}" IsChecked="{Binding StartupFilter, Converter={StaticResource Eq}, ConverterParameter=ScheduledTask}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc startup.kind.ShellExtension}" IsChecked="{Binding StartupFilter, Converter={StaticResource Eq}, ConverterParameter=ShellExtension}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc startup.kind.RunOnce}" IsChecked="{Binding StartupFilter, Converter={StaticResource Eq}, ConverterParameter=RunOnce}"/>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{i:Loc startup.rescan}" Style="{StaticResource Button.Small}" Command="{Binding RescanStartupCommand}" IsEnabled="{Binding ScanningStartup, Converter={StaticResource Not}}" Margin="0,0,8,0"/>
                        <Button Content="{i:Loc startup.uninstall}" Style="{StaticResource Button.Small}" Command="{Binding OpenAppsSettingsCommand}"/>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding StartupRows}" MaxHeight="640">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{i:Loc startup.col.name}" Binding="{Binding Name}" Width="1.4*"/>
                            <DataGridTextColumn Header="{i:Loc startup.col.kind}" Binding="{Binding KindLabel}" Width="110"/>
                            <DataGridTextColumn Header="{i:Loc startup.col.publisher}" Binding="{Binding Publisher}" Width="*"/>
                            <DataGridTemplateColumn Header="{i:Loc startup.col.class}" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Badge}" Background="{Binding Classification, Converter={StaticResource LevelBrush}, ConverterParameter=soft}" ToolTip="{Binding Reason}">
                                            <TextBlock Style="{StaticResource Text.Badge}" Text="{Binding ClassificationLabel}" Foreground="{Binding Classification, Converter={StaticResource LevelBrush}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{i:Loc startup.col.command}" Binding="{Binding Command}" Width="1.6*"/>
                            <DataGridTemplateColumn Header="{i:Loc startup.col.state}" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanToggle}">
                                            <Button Content="{i:Loc common.disable}" Style="{StaticResource Button.Small}" Command="{Binding DisableCommand}" Margin="0,0,4,0"
                                                    Visibility="{Binding Enabled, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="{i:Loc common.enable}" Style="{StaticResource Button.SmallPrimary}" Command="{Binding EnableCommand}"
                                                    Visibility="{Binding Enabled, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{i:Loc startup.legend}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Rejected tweaks: transparency about what FrameCore will not do -->
                <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqVis}, ConverterParameter=Rejected}">
                    <TextBlock Text="{i:Loc rejected.title}" Style="{StaticResource Text.Section}"/>
                    <TextBlock Text="{i:Loc rejected.subtitle}" Style="{StaticResource Text.Muted}" Margin="0,0,0,12"/>
                    <ItemsControl ItemsSource="{Binding Rejected}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="{StaticResource Pad.CardCompact}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <WrapPanel>
                                            <Border Style="{StaticResource Badge}" Background="{Binding LevelKey, Converter={StaticResource LevelBrush}, ConverterParameter=soft}">
                                                <TextBlock Style="{StaticResource Text.Badge}" Text="{Binding KindLabel}" Foreground="{Binding LevelKey, Converter={StaticResource LevelBrush}}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,0,4"/>
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,4,0,0"><Run Text="{i:Loc rejected.claim}" FontWeight="SemiBold"/> <Run Text="{Binding Claim, Mode=OneWay}"/></TextBlock>
                                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,4,0,0"><Run Text="{i:Loc rejected.verdict}" FontWeight="SemiBold"/> <Run Text="{Binding Verdict, Mode=OneWay}"/></TextBlock>
                                        <TextBlock Text="{Binding Sources}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" Visibility="{Binding Sources, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Custom profiles -->
                <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqVis}, ConverterParameter=Profiles}">
                    <TextBlock Text="{i:Loc pro.profiles.title}" Style="{StaticResource Text.Section}"/>
                    <TextBlock Text="{i:Loc pro.profiles.desc}" Style="{StaticResource Text.Muted}" Margin="0,0,0,10"/>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="{i:Loc pro.profiles.import}" Style="{StaticResource Button.Secondary}" Command="{Binding ImportCustomProfileCommand}" Margin="8,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="{i:Loc pro.profiles.save}" Style="{StaticResource Button.Primary}" Command="{Binding SaveCurrentAsProfileCommand}" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding CustomProfiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Inset}" Margin="0,0,0,6">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="{i:Loc common.apply}" Style="{StaticResource Button.SmallPrimary}" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.ApplyCustomProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Button Content="{i:Loc pro.profiles.export}" Style="{StaticResource Button.Small}" Margin="0,0,6,0"
                                                    Command="{Binding DataContext.ExportCustomProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Button Content="{i:Loc common.delete}" Style="{StaticResource Button.Small}"
                                                    Command="{Binding DataContext.DeleteCustomProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}"/>
                                            <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{Binding TweakIds.Count, Mode=OneWay}"/> <Run Text="{i:Loc pro.profiles.items}"/></TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Monitoring -->
                <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqVis}, ConverterParameter=Monitoring}">
                    <TextBlock Text="{i:Loc pro.monitor.title}" Style="{StaticResource Text.Section}"/>
                    <TextBlock Text="{Binding MonitorText}" Style="{StaticResource Text.Muted}" Margin="0,0,0,10"/>
                    <UniformGrid Columns="2" Margin="-6,0">
                        <Border Style="{StaticResource Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="{i:Loc pro.monitor.cpu}" Style="{StaticResource Text.Caption}"/>
                                <i:SparkChart Values="{Binding CpuHistory}" Height="90" Stroke="{DynamicResource Brush.Chart1}" Fill="{DynamicResource Brush.ChartFill}" GridBrush="{DynamicResource Brush.Grid}" Capacity="120"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="{i:Loc pro.monitor.gpu}" Style="{StaticResource Text.Caption}"/>
                                <i:SparkChart Values="{Binding GpuHistory}" Height="90" Stroke="{DynamicResource Brush.Chart2}" GridBrush="{DynamicResource Brush.Grid}" Capacity="120"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="{i:Loc pro.monitor.ram}" Style="{StaticResource Text.Caption}"/>
                                <i:SparkChart Values="{Binding RamHistory}" Height="90" Stroke="{DynamicResource Brush.Chart3}" GridBrush="{DynamicResource Brush.Grid}" Capacity="120"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="6">
                            <StackPanel>
                                <TextBlock Text="{i:Loc pro.monitor.temps}" Style="{StaticResource Text.Caption}"/>
                                <Grid Height="90">
                                    <i:SparkChart Values="{Binding CpuTempHistory}" Stroke="{DynamicResource Brush.Chart4}" GridBrush="{DynamicResource Brush.Grid}" Capacity="120" Maximum="110"/>
                                    <i:SparkChart Values="{Binding GpuTempHistory}" Stroke="{DynamicResource Brush.Chart2}" Capacity="120" Maximum="110"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock Text="{i:Loc hw.perCore}" Style="{StaticResource Text.Caption}" Margin="0,10,0,4"/>
                    <ItemsControl ItemsSource="{Binding PerCore}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="64" Margin="0,0,8,6">
                                    <TextBlock Text="{Binding StringFormat='{}{0:0} %'}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}"/>
                                    <ProgressBar Value="{Binding Mode=OneWay}" Maximum="100" Height="5"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
