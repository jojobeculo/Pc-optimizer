<UserControl x:Class="FrameCore.UI.Views.LabPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:FrameCore.UI.Infrastructure">
    <UserControl.Resources>
        <Style x:Key="LabTile" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="MinHeight" Value="96"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Card}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.CardHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="{i:Loc lab.desc}" Style="{StaticResource Text.Muted}" Margin="0,0,0,14" MaxWidth="820" HorizontalAlignment="Left"/>
        <UniformGrid Columns="3">
            <Button Style="{StaticResource LabTile}" Command="{Binding LabCommand}" CommandParameter="cpu" IsEnabled="{Binding Running, Converter={StaticResource Not}}">
                <StackPanel>
                    <i:Icon Glyph="{StaticResource Icon.Chip}" Width="22" Height="22" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{i:Loc lab.cpu}" Style="{StaticResource Text.CardTitle}" Margin="0,8,0,2"/>
                    <TextBlock Text="{i:Loc lab.cpu.desc}" Style="{StaticResource Text.Caption}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource LabTile}" Command="{Binding LabCommand}" CommandParameter="memory" IsEnabled="{Binding Running, Converter={StaticResource Not}}">
                <StackPanel>
                    <i:Icon Glyph="{StaticResource Icon.Ram}" Width="22" Height="22" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{i:Loc lab.memory}" Style="{StaticResource Text.CardTitle}" Margin="0,8,0,2"/>
                    <TextBlock Text="{i:Loc lab.memory.desc}" Style="{StaticResource Text.Caption}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource LabTile}" Command="{Binding LabCommand}" CommandParameter="gpu" IsEnabled="{Binding Running, Converter={StaticResource Not}}">
                <StackPanel>
                    <i:Icon Glyph="{StaticResource Icon.Gpu}" Width="22" Height="22" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{i:Loc lab.gpu}" Style="{StaticResource Text.CardTitle}" Margin="0,8,0,2"/>
                    <TextBlock Text="{i:Loc lab.gpu.desc}" Style="{StaticResource Text.Caption}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource LabTile}" Command="{Binding LabCommand}" CommandParameter="storage" IsEnabled="{Binding Running, Converter={StaticResource Not}}">
                <StackPanel>
                    <i:Icon Glyph="{StaticResource Icon.Disk}" Width="22" Height="22" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{i:Loc lab.storage}" Style="{StaticResource Text.CardTitle}" Margin="0,8,0,2"/>
                    <TextBlock Text="{i:Loc lab.storage.desc}" Style="{StaticResource Text.Caption}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource LabTile}" Command="{Binding LabCommand}" CommandParameter="system" IsEnabled="{Binding Running, Converter={StaticResource Not}}">
                <StackPanel>
                    <i:Icon Glyph="{StaticResource Icon.Timer}" Width="22" Height="22" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{i:Loc lab.system}" Style="{StaticResource Text.CardTitle}" Margin="0,8,0,2"/>
                    <TextBlock Text="{i:Loc lab.system.desc}" Style="{StaticResource Text.Caption}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource LabTile}" Command="{Binding LabCommand}" CommandParameter="inference" IsEnabled="{Binding Running, Converter={StaticResource Not}}">
                <StackPanel>
                    <i:Icon Glyph="{StaticResource Icon.Brain}" Width="22" Height="22" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{i:Loc lab.inference}" Style="{StaticResource Text.CardTitle}" Margin="0,8,0,2"/>
                    <TextBlock Text="{i:Loc lab.inference.desc}" Style="{StaticResource Text.Caption}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource LabTile}" Command="{Binding LabCommand}" CommandParameter="lan" IsEnabled="{Binding Running, Converter={StaticResource Not}}">
                <StackPanel>
                    <i:Icon Glyph="{StaticResource Icon.Network}" Width="22" Height="22" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{i:Loc lab.lan}" Style="{StaticResource Text.CardTitle}" Margin="0,8,0,2"/>
                    <TextBlock Text="{i:Loc lab.lan.desc}" Style="{StaticResource Text.Caption}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource LabTile}" Command="{Binding LabCommand}" CommandParameter="internet" IsEnabled="{Binding Running, Converter={StaticResource Not}}">
                <StackPanel>
                    <i:Icon Glyph="{StaticResource Icon.Wifi}" Width="22" Height="22" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{i:Loc lab.internet}" Style="{StaticResource Text.CardTitle}" Margin="0,8,0,2"/>
                    <TextBlock Text="{i:Loc lab.internet.desc}" Style="{StaticResource Text.Caption}"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource LabTile}" Command="{Binding LabCommand}" CommandParameter="stress" IsEnabled="{Binding Running, Converter={StaticResource Not}}">
                <StackPanel>
                    <i:Icon Glyph="{StaticResource Icon.Overclock}" Width="22" Height="22" Foreground="{DynamicResource Brush.Warning}" HorizontalAlignment="Left"/>
                    <TextBlock Text="{i:Loc lab.stress}" Style="{StaticResource Text.CardTitle}" Margin="0,8,0,2"/>
                    <TextBlock Text="{i:Loc lab.stress.desc}" Style="{StaticResource Text.Caption}"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <Border Style="{StaticResource Card}" Padding="{StaticResource Pad.CardCompact}">
            <WrapPanel>
                <CheckBox Content="{i:Loc lab.net.consent}" IsChecked="{Binding NetworkConsent}" Margin="0,0,24,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="{i:Loc lab.stress.duration}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <RadioButton Style="{StaticResource Segment}" Content="2 min" IsChecked="{Binding StressMinutes, Converter={StaticResource Eq}, ConverterParameter=2}"/>
                    <RadioButton Style="{StaticResource Segment}" Content="5 min" IsChecked="{Binding StressMinutes, Converter={StaticResource Eq}, ConverterParameter=5}"/>
                    <RadioButton Style="{StaticResource Segment}" Content="15 min" IsChecked="{Binding StressMinutes, Converter={StaticResource Eq}, ConverterParameter=15}"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Small}" Content="{i:Loc common.cancel}" Command="{Binding CancelCommand}"
                            Visibility="{Binding Running, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{i:Loc lab.results}" Style="{StaticResource Text.CardTitle}" VerticalAlignment="Center"/>
                </DockPanel>
                <ProgressBar IsIndeterminate="True" Margin="0,0,0,10" Visibility="{Binding Running, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding LabStatus}" Style="{StaticResource Text.Body}" Margin="0,0,0,10"/>
                <TextBlock Text="{i:Loc lab.empty}" Style="{StaticResource Text.Muted}" Visibility="{Binding LabResults.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                <StackPanel Visibility="{Binding LabResults.Count, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="{i:Loc lab.results}">
                        <Grid Margin="8,0,8,6"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{i:Loc quick.col.metric}" Style="{StaticResource Text.Overline}" Margin="0,0,10,0"/><TextBlock Grid.Column="1" Text="{i:Loc quick.col.component}" Style="{StaticResource Text.Overline}" Margin="0,0,10,0"/><TextBlock Grid.Column="2" Text="{i:Loc quick.col.median}" Style="{StaticResource Text.Overline}" Margin="0,0,10,0"/><TextBlock Grid.Column="3" Text="{i:Loc quick.col.unit}" Style="{StaticResource Text.Overline}" Margin="0,0,10,0"/><TextBlock Grid.Column="4" Text="{i:Loc quick.col.spread}" Style="{StaticResource Text.Overline}" Margin="0,0,10,0"/></Grid>
                        <ItemsControl ItemsSource="{Binding LabResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Brush.Grid}" BorderThickness="0,1,0,0" Padding="8,7">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding Name}" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="Medium"/><TextBlock Grid.Column="1" Text="{Binding Component}" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/><TextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center" FontFamily="{StaticResource Font.Mono}"/><TextBlock Grid.Column="3" Text="{Binding Unit}" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}"/><TextBlock Grid.Column="4" Text="{Binding Spread}" TextWrapping="Wrap" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" FontSize="12"/></Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                <TextBlock Text="{i:Loc lab.tools}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
