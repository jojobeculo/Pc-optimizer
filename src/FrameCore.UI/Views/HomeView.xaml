<UserControl x:Class="FrameCore.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:FrameCore.UI.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Pad.Page}">
            <TextBlock Text="{i:Loc home.title}" Style="{StaticResource Text.PageTitle}"/>
            <TextBlock Text="{Binding Signature}" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,18"/>

            <!-- Hero: optimisation level (factual), health, quick actions -->
            <Border Style="{StaticResource Card.Hero}" Margin="0,0,0,12" i:Motion.Enter="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="150" Height="150" Margin="0,0,24,0" ToolTip="{i:Loc home.gauge.tip}">
                        <i:GaugeRing Value="{Binding OptimizedFraction}" Thickness="11" Track="{DynamicResource Brush.Inset}" Fill="{DynamicResource Brush.Accent}"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Metric}" FontSize="32">
                                <Run Text="{Binding OptimizedCount, Mode=OneWay}"/><Run Text="/" Foreground="{DynamicResource Brush.TextFaint}"/><Run Text="{Binding OptimizableCount, Mode=OneWay}" Foreground="{DynamicResource Brush.TextMuted}"/>
                            </TextBlock>
                            <TextBlock Text="{i:Loc home.gauge.caption}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="110"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{i:Loc home.health}" Style="{StaticResource Text.Overline}"/>
                        <TextBlock Text="{Binding HealthTitle}" Style="{StaticResource Text.PageTitle}" FontSize="22" Margin="0,2,0,8"/>
                        <WrapPanel Margin="0,0,0,12">
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.DangerSoft}">
                                <TextBlock Style="{StaticResource Text.Badge}" Foreground="{DynamicResource Brush.Danger}"><Run Text="{Binding Critical, Mode=OneWay}"/> <Run Text="{i:Loc home.critical}"/></TextBlock>
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.WarningSoft}">
                                <TextBlock Style="{StaticResource Text.Badge}" Foreground="{DynamicResource Brush.Warning}"><Run Text="{Binding Warnings, Mode=OneWay}"/> <Run Text="{i:Loc home.warnings}"/></TextBlock>
                            </Border>
                            <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.InfoSoft}">
                                <TextBlock Style="{StaticResource Text.Badge}" Foreground="{DynamicResource Brush.Info}"><Run Text="{Binding Suggestions, Mode=OneWay}"/> <Run Text="{i:Loc home.suggestions}"/></TextBlock>
                            </Border>
                        </WrapPanel>
                        <WrapPanel>
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding Shell.NavigateCommand}" CommandParameter="optimization" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <i:Icon Glyph="{StaticResource Icon.Optimize}" Width="15" Height="15" Foreground="{DynamicResource Brush.OnAccent}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{i:Loc home.goOptimize}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Secondary}" Command="{Binding Shell.NavigateCommand}" CommandParameter="benchmark" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <i:Icon Glyph="{StaticResource Icon.Bench}" Width="15" Height="15" Foreground="{DynamicResource Brush.Text}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{i:Loc home.goBench}"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Secondary}" Command="{Binding Shell.NavigateCommand}" CommandParameter="games" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <i:Icon Glyph="{StaticResource Icon.Games}" Width="15" Height="15" Foreground="{DynamicResource Brush.Text}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{i:Loc home.goGames}"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"><Run Text="{i:Loc home.lastOptTitle}"/> : <Run Text="{Binding LastOptimization, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Interrupted operation / post-reboot verification -->
            <Border Style="{StaticResource Banner}" BorderBrush="{DynamicResource Brush.Warning}" Background="{DynamicResource Brush.WarningSoft}"
                    Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Small}" Content="{i:Loc home.pending.open}" VerticalAlignment="Center" Margin="12,0,0,0"
                            Command="{Binding Shell.NavigateCommand}" CommandParameter="restore"/>
                    <TextBlock Text="{Binding PendingText}" Style="{StaticResource Text.Body}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Hardware cards -->
            <UniformGrid Columns="3" Margin="-7,0,-7,14">
                <Border Style="{StaticResource Card}" Margin="7">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CpuUsage}" Style="{StaticResource Text.Metric}" FontSize="22"/>
                            <StackPanel>
                                <TextBlock Text="{i:Loc hw.cpu}" Style="{StaticResource Text.Caption}"/>
                                <TextBlock Text="{Binding CpuName}" Style="{StaticResource Text.CardTitle}"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding CpuDetail}" Style="{StaticResource Text.Muted}" Margin="0,4,0,8"/>
                        <i:SparkChart Values="{Binding CpuHistory}" Height="54" Stroke="{DynamicResource Brush.Chart1}" Fill="{DynamicResource Brush.ChartFill}" GridBrush="{DynamicResource Brush.Grid}" Capacity="120"/>
                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Text="{Binding CpuTemp}" Style="{StaticResource Text.Muted}" Margin="0,0,14,0"/>
                            <TextBlock Text="{Binding CpuClock}" Style="{StaticResource Text.Muted}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="7">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding GpuUsage}" Style="{StaticResource Text.Metric}" FontSize="22"/>
                            <StackPanel>
                                <TextBlock Text="{i:Loc hw.gpu}" Style="{StaticResource Text.Caption}"/>
                                <TextBlock Text="{Binding GpuName}" Style="{StaticResource Text.CardTitle}"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding GpuDetail}" Style="{StaticResource Text.Muted}" Margin="0,4,0,8"/>
                        <i:SparkChart Values="{Binding GpuHistory}" Height="54" Stroke="{DynamicResource Brush.Chart2}" GridBrush="{DynamicResource Brush.Grid}" Capacity="120"/>
                        <WrapPanel Margin="0,8,0,0">
                            <TextBlock Text="{Binding GpuTemp}" Style="{StaticResource Text.Muted}" Margin="0,0,14,0"/>
                            <TextBlock Text="{Binding GpuVram}" Style="{StaticResource Text.Muted}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="7">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding RamUsage}" Style="{StaticResource Text.Metric}" FontSize="22"/>
                            <StackPanel>
                                <TextBlock Text="{i:Loc hw.ram}" Style="{StaticResource Text.Caption}"/>
                                <TextBlock Text="{Binding RamTotal}" Style="{StaticResource Text.CardTitle}"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="{Binding RamDetail}" Style="{StaticResource Text.Muted}" Margin="0,4,0,8"/>
                        <i:SparkChart Values="{Binding RamHistory}" Height="54" Stroke="{DynamicResource Brush.Chart3}" GridBrush="{DynamicResource Brush.Grid}" Capacity="120"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="7">
                    <StackPanel>
                        <TextBlock Text="{i:Loc hw.storage}" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Text="{Binding StorageTitle}" Style="{StaticResource Text.CardTitle}"/>
                        <TextBlock Text="{Binding StorageDetail}" Style="{StaticResource Text.Muted}" Margin="0,4,0,8"/>
                        <ProgressBar Value="{Binding SystemFreePercent, Mode=OneWay}" Maximum="100"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="7">
                    <StackPanel>
                        <TextBlock Text="{i:Loc hw.display}" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Text="{Binding DisplayTitle}" Style="{StaticResource Text.CardTitle}"/>
                        <TextBlock Text="{Binding DisplayDetail}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="7">
                    <StackPanel>
                        <TextBlock Text="{i:Loc hw.windows}" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Text="{Binding WindowsTitle}" Style="{StaticResource Text.CardTitle}"/>
                        <TextBlock Text="{Binding WindowsDetail}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="{i:Loc home.findings}" Style="{StaticResource Text.Section}"/>
            <TextBlock Text="{i:Loc home.noDiagnostic}" Style="{StaticResource Text.Muted}" Visibility="{Binding HasDiagnostic, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
            <ItemsControl ItemsSource="{Binding Findings}" ItemTemplate="{StaticResource FindingTemplate}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
