<UserControl x:Class="FrameCore.UI.Views.QuickBenchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:FrameCore.UI.Infrastructure">
    <UserControl.Resources>
        <!-- Step progress: one segment per real step, filled with the real fraction of that step -->
        <DataTemplate x:Key="StepSegment">
            <StackPanel Margin="0,0,6,0">
                <Border Height="6" CornerRadius="3" Background="{DynamicResource Brush.Inset}" ClipToBounds="True">
                    <Border x:Name="Fill" CornerRadius="3" Background="{DynamicResource Brush.Accent}" i:Motion.Fraction="{Binding Fraction}"/>
                </Border>
                <TextBlock x:Name="Label" Text="{Binding Title}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="active">
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="done">
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.AccentText}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="skipped">
                    <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Brush.BorderStrong}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- Clickable row (opens the detail of a measurement) -->
        <Style x:Key="RowToggle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="10,9">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.CardHover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Inset}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Small bar of a history chart (tooltip = date, name and value) -->
        <DataTemplate x:Key="MiniBar">
            <Border x:Name="Slot" Background="Transparent" Margin="1.5,0" ToolTip="{Binding Tip}" ToolTipService.InitialShowDelay="0">
                <Border x:Name="Bar" CornerRadius="3,3,1,1" Background="{DynamicResource Brush.Chart2}" Opacity="0.5" i:Motion.FractionY="{Binding Fraction}"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                    <Setter TargetName="Bar" Property="Opacity" Value="1"/>
                </DataTrigger>
                <Trigger SourceName="Slot" Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Opacity" Value="1"/></Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="BarsPanel"><UniformGrid Rows="1"/></ItemsPanelTemplate>
    </UserControl.Resources>
    <StackPanel>
        <!-- Launch card -->
        <Border Style="{StaticResource Card.Hero}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{i:Loc quick.title}" Style="{StaticResource Text.Section}" Margin="0"/>
                    <TextBlock Text="{i:Loc quick.desc}" Style="{StaticResource Text.Muted}" Margin="0,4,0,12" MaxWidth="640" HorizontalAlignment="Left"/>
                    <WrapPanel>
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc quick.mode.standard}" IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=standard}" IsEnabled="{Binding Running, Converter={StaticResource Not}}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc quick.mode.express}" IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=express}" IsEnabled="{Binding Running, Converter={StaticResource Not}}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="{i:Loc quick.mode.complete}" IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=complete}" IsEnabled="{Binding Running, Converter={StaticResource Not}}"
                                     ToolTip="{i:Loc quick.mode.complete.tip}"/>
                    </WrapPanel>
                    <DockPanel Margin="0,6,0,0" MaxWidth="460" HorizontalAlignment="Left">
                        <TextBlock DockPanel.Dock="Left" Text="{i:Loc bench.label}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{i:Loc bench.label}" Tag="{i:Loc quick.labelHint}" MinWidth="300"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding StartCommand}" IsEnabled="{Binding Running, Converter={StaticResource Not}}" MinWidth="190">
                        <StackPanel Orientation="Horizontal">
                            <i:Icon Glyph="{StaticResource Icon.Play}" Width="15" Height="15" Foreground="{DynamicResource Brush.OnAccent}" Margin="0,0,8,0"/>
                            <TextBlock Text="{i:Loc quick.start}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Secondary}" Content="{i:Loc common.cancel}" Command="{Binding CancelCommand}" Margin="0,8,0,0"
                            Visibility="{Binding Running, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Running: real progress per step -->
        <Border Style="{StaticResource Card}" Visibility="{Binding Running, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Metric}" FontSize="22" i:Motion.CountFormat="0 %" i:Motion.CountTo="{Binding Overall}"/>
                    <StackPanel>
                        <TextBlock Text="{i:Loc quick.inProgress}" Style="{StaticResource Text.Overline}"/>
                        <TextBlock Text="{Binding CurrentStep}" Style="{StaticResource Text.CardTitle}"/>
                    </StackPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepSegment}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="{i:Loc quick.keepIdle}" Style="{StaticResource Text.Caption}" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- Latest result -->
        <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{i:Loc quick.latest}" Style="{StaticResource Text.Section}" Margin="0,8,0,10"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <WrapPanel Margin="0,0,0,10">
                        <Border Style="{StaticResource Badge}" Background="{DynamicResource Brush.NeutralSoft}">
                            <StackPanel Orientation="Horizontal">
                                <i:Icon Glyph="{StaticResource Icon.Thermo}" Width="13" Height="13" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,6,0"/>
                                <TextBlock Style="{StaticResource Text.Badge}" Text="{Binding ThermalText}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <TextBlock Text="{Binding ThrottleText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <!-- Complete mode: stability under the combined CPU + GPU load -->
                    <Border Style="{StaticResource Inset}" Margin="0,0,0,12" Visibility="{Binding StressText, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{i:Loc quick.stress.title}" Style="{StaticResource Text.CardTitle}"/>
                            <TextBlock Text="{Binding StressText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Foreground="{Binding StressKey, Converter={StaticResource LevelBrush}}"/>
                        </StackPanel>
                    </Border>
                    <!-- At a glance: one card per component -->
                    <TextBlock Text="{i:Loc quick.summary.title}" Style="{StaticResource Text.Overline}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Components}" Margin="-4,0,-4,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource WidthToColumns}, ConverterParameter=980:2:5}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Inset}" Margin="4" Padding="14,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <i:Icon Glyph="{Binding Icon, Converter={StaticResource Res}}" Width="16" Height="16" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Metric}" FontSize="24"/>
                                            <TextBlock Text="{Binding Unit}" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" Margin="5,0,0,4" TextWrapping="Wrap" MaxWidth="120"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Headline}" Style="{StaticResource Text.Caption}"/>
                                        <ItemsControl ItemsSource="{Binding History}" ItemTemplate="{StaticResource MiniBar}" ItemsPanel="{StaticResource BarsPanel}" Height="30" Margin="0,8,0,0"
                                                      Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding Trend}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{Binding TrendKey, Converter={StaticResource LevelBrush}}"/>
                                        <TextBlock Text="{Binding What}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Every measurement: click for the detail -->
                    <DockPanel Margin="0,4,0,4">
                        <TextBlock DockPanel.Dock="Right" Text="{i:Loc quick.details.click}" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom"/>
                        <TextBlock Text="{i:Loc quick.col.metric}" Style="{StaticResource Text.Overline}"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Metrics}" AutomationProperties.Name="{i:Loc quick.latest}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Grid}" BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <Button Style="{StaticResource RowToggle}" AutomationProperties.Name="{Binding Name}"
                                                Command="{Binding DataContext.ToggleRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="2.2*"/>
                                                    <ColumnDefinition Width="1.3*"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                </Grid.ColumnDefinitions>
                                                <i:Icon x:Name="Chevron" Glyph="{StaticResource Icon.ChevronRight}" Width="14" Height="14" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Component}" Style="{StaticResource Text.Caption}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Font.Mono}" FontSize="16" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Unit}" Style="{StaticResource Text.Caption}" Margin="5,0,0,0" VerticalAlignment="Bottom"/>
                                                </StackPanel>
                                                <ItemsControl Grid.Column="3" ItemsSource="{Binding History}" ItemTemplate="{StaticResource MiniBar}" ItemsPanel="{StaticResource BarsPanel}" Height="24"
                                                              Width="160" HorizontalAlignment="Left" Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Spread}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                           Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                            </Grid>
                                        </Button>
                                        <!-- Detail -->
                                        <Border Margin="32,0,10,12" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding What}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Visibility="{Binding HasWhat, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/>
                                                <StackPanel Visibility="{Binding HasSamples, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                                    <i:SamplePlot Samples="{Binding Samples}" Median="{Binding Median}" Low="{Binding CiLow}" High="{Binding CiHigh}" Unit="{Binding Unit}" Height="52"
                                                                  DotBrush="{DynamicResource Brush.Accent}" BandBrush="{DynamicResource Brush.ChartFill}" AxisBrush="{DynamicResource Brush.TextMuted}"/>
                                                    <TextBlock Text="{i:Loc quick.details.samples}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Spread}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                <TextBlock Text="{Binding Noise}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                                                <StackPanel Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                                    <TextBlock Text="{i:Loc quick.details.history}" Style="{StaticResource Text.Overline}" Margin="0,0,0,6"/>
                                                    <ItemsControl ItemsSource="{Binding History}" ItemsPanel="{StaticResource BarsPanel}" MaxWidth="520" HorizontalAlignment="Left">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="2,0" MinWidth="34">
                                                                    <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" FontSize="10.5"/>
                                                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MiniBar}" Height="56"/>
                                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" FontSize="10.5"/>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter TargetName="Chevron" Property="Glyph" Value="{StaticResource Icon.ChevronDown}"/>
                                        <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Before / after -->
        <TextBlock Text="{i:Loc quick.compare}" Style="{StaticResource Text.Section}" Margin="0,8,0,10"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{i:Loc quick.compare.desc}" Style="{StaticResource Text.Muted}" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{i:Loc quick.before}" Style="{StaticResource Text.Overline}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding History}" SelectedItem="{Binding CompareBefore}" DisplayMemberPath="Title" AutomationProperties.Name="{i:Loc quick.before}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{i:Loc quick.after}" Style="{StaticResource Text.Overline}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding History}" SelectedItem="{Binding CompareAfter}" DisplayMemberPath="Title" AutomationProperties.Name="{i:Loc quick.after}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="{i:Loc quick.needTwo}" Style="{StaticResource Text.Muted}" Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                <StackPanel Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}">
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Small}" Content="{i:Loc quick.share.export}" Command="{Binding ExportComparisonCommand}"
                                    ToolTip="{i:Loc quick.share.tip}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <TextBlock Style="{StaticResource Text.Metric}" FontSize="24" i:Motion.CountFormat="0.0" i:Motion.CountTo="{Binding IndexValue}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding ComparisonTitle}" Style="{StaticResource Text.CardTitle}"/>
                            <TextBlock Text="{Binding IndexText}" Style="{StaticResource Text.Caption}"/>
                        </StackPanel>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Border Width="12" Height="8" CornerRadius="2" Background="{DynamicResource Brush.Chart2}" Opacity="0.6" Margin="0,0,5,0"/>
                            <TextBlock Text="{i:Loc quick.compare.legendBefore}" Style="{StaticResource Text.Caption}" Margin="0,0,14,0"/>
                            <Border Width="12" Height="8" CornerRadius="2" Background="{DynamicResource Brush.Accent}" Margin="0,0,5,0"/>
                            <TextBlock Text="{i:Loc quick.compare.legendAfter}" Style="{StaticResource Text.Caption}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ComparisonSummary}" Style="{StaticResource Text.Body}" FontWeight="Medium" TextWrapping="Wrap"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Comparison}" AutomationProperties.Name="{i:Loc quick.compare}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.Grid}" BorderThickness="0,1,0,0">
                                    <StackPanel>
                                        <Button Style="{StaticResource RowToggle}" AutomationProperties.Name="{Binding Name}"
                                                Command="{Binding DataContext.ToggleComparisonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="3*"/>
                                                    <ColumnDefinition Width="1.6*"/>
                                                </Grid.ColumnDefinitions>
                                                <i:Icon x:Name="Chevron" Glyph="{StaticResource Icon.ChevronRight}" Width="14" Height="14" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <!-- Before / after bars: the taller (longer) bar is always the better result -->
                                                <Grid Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MinWidth="96"/></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="4"/><RowDefinition/></Grid.RowDefinitions>
                                                    <Border Height="9" CornerRadius="4" Background="{DynamicResource Brush.Inset}" ClipToBounds="True" VerticalAlignment="Center">
                                                        <Border CornerRadius="4" Background="{DynamicResource Brush.Chart2}" Opacity="0.6" i:Motion.Fraction="{Binding BeforeFraction}"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Before}" Style="{StaticResource Text.Caption}" FontFamily="{StaticResource Font.Mono}" Margin="8,0,0,0"/>
                                                    <Border Grid.Row="2" Height="9" CornerRadius="4" Background="{DynamicResource Brush.Inset}" ClipToBounds="True" VerticalAlignment="Center">
                                                        <Border CornerRadius="4" Background="{DynamicResource Brush.Accent}" i:Motion.Fraction="{Binding AfterFraction}"/>
                                                    </Border>
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding After}" Style="{StaticResource Text.Caption}" FontFamily="{StaticResource Font.Mono}" Margin="8,0,0,0" Foreground="{DynamicResource Brush.Text}"/>
                                                </Grid>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource Badge}" HorizontalAlignment="Left" Margin="0" Background="{Binding VerdictKey, Converter={StaticResource LevelBrush}, ConverterParameter=soft}">
                                                        <TextBlock Style="{StaticResource Text.Badge}" Text="{Binding Percent}" Foreground="{Binding VerdictKey, Converter={StaticResource LevelBrush}}" FontFamily="{StaticResource Font.Mono}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Verdict}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{Binding VerdictKey, Converter={StaticResource LevelBrush}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Border Margin="32,0,10,12" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding What}" Style="{StaticResource Text.Body}" TextWrapping="Wrap"/>
                                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap">
                                                    <Run Text="{Binding Direction, Mode=OneWay}"/> · <Run Text="{i:Loc quick.col.diff}"/> <Run Text="{Binding Absolute, Mode=OneWay}"/> · <Run Text="{Binding Confidence, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Noise}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter TargetName="Chevron" Property="Glyph" Value="{StaticResource Icon.ChevronDown}"/>
                                        <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- History -->
        <TextBlock Text="{i:Loc quick.history}" Style="{StaticResource Text.Section}" Margin="0,8,0,10"/>
        <TextBlock Text="{i:Loc quick.history.empty}" Style="{StaticResource Text.Muted}" Visibility="{Binding History.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
        <Border Style="{StaticResource Card}" Visibility="{Binding ChartBars.Count, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding ChartMetrics}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding ChartMetric}"
                              MinWidth="240" AutomationProperties.Name="{i:Loc quick.chart.title}"/>
                    <StackPanel>
                        <TextBlock Text="{i:Loc quick.chart.title}" Style="{StaticResource Text.CardTitle}"/>
                        <TextBlock Text="{i:Loc quick.chart.desc}" Style="{StaticResource Text.Caption}"/>
                    </StackPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding ChartBars}" ItemsPanel="{StaticResource BarsPanel}" MaxWidth="900" HorizontalAlignment="Left">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RowToggle}" Padding="0" MinWidth="44" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}"
                                    Command="{Binding DataContext.ShowRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" FontFamily="{StaticResource Font.Mono}"/>
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource MiniBar}" Height="110" Margin="4,4,4,4"/>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <ItemsControl ItemsSource="{Binding History}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Inset}" Margin="0,0,0,6">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" ToolTip="{i:Loc common.delete}" AutomationProperties.Name="{i:Loc common.delete}"
                                    Command="{Binding DataContext.DeleteRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                <i:Icon Glyph="{StaticResource Icon.Trash}" Width="15" Height="15" Foreground="{DynamicResource Brush.TextMuted}"/>
                            </Button>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="Medium"/>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
