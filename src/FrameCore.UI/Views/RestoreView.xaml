<UserControl x:Class="FrameCore.UI.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:FrameCore.UI.Infrastructure">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Pad.Page}">
            <TextBlock Text="{i:Loc restore.title}" Style="{StaticResource Text.PageTitle}"/>
            <TextBlock Text="{i:Loc restore.subtitle}" Style="{StaticResource Text.Subtitle}" MaxWidth="820" HorizontalAlignment="Left" Margin="0,4,0,18"/>

            <!-- Back to before FrameCore: always possible while FrameCore is installed, however old the changes -->
            <Border Style="{StaticResource Card.Hero}" Margin="0,0,0,14" i:Motion.Enter="0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <i:Icon Glyph="{StaticResource Icon.Undo}" Width="20" Height="20" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0"/>
                            <TextBlock Text="{i:Loc restore.original.title}" Style="{StaticResource Text.Section}" Margin="0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding OriginalStateText}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="Medium"/>
                        <TextBlock Text="{i:Loc restore.original.desc}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0" MaxWidth="760" HorizontalAlignment="Left"/>
                        <TextBlock Text="{i:Loc restore.handover.steps}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="760" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Danger}" Command="{Binding Pro.RestoreAllCommand}" MinWidth="230" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <i:Icon Glyph="{StaticResource Icon.Undo}" Width="15" Height="15" Foreground="{DynamicResource Brush.Danger}" Margin="0,0,8,0"/>
                                <TextBlock Text="{i:Loc restore.original.button}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Secondary}" Command="{Binding HandOverCommand}" MinWidth="230" ToolTip="{i:Loc restore.handover.tip}">
                            <TextBlock Text="{i:Loc restore.handover.button}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Summary tiles -->
            <UniformGrid Columns="3" Margin="0,0,0,4">
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" i:Motion.Enter="0">
                    <StackPanel>
                        <TextBlock Text="{i:Loc restore.active}" Style="{StaticResource Text.Overline}"/>
                        <TextBlock Style="{StaticResource Text.Metric}" i:Motion.CountTo="{Binding ActiveCount}"/>
                        <TextBlock Text="{i:Loc restore.activeHint}" Style="{StaticResource Text.Caption}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,12,12" i:Motion.Enter="1">
                    <StackPanel>
                        <TextBlock Text="{i:Loc restore.verified}" Style="{StaticResource Text.Overline}"/>
                        <TextBlock Style="{StaticResource Text.Metric}" Foreground="{DynamicResource Brush.AccentText}" i:Motion.CountTo="{Binding VerifiedCount}"/>
                        <TextBlock Text="{i:Loc restore.verifiedHint}" Style="{StaticResource Text.Caption}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,0,12" i:Motion.Enter="2">
                    <StackPanel>
                        <TextBlock Text="{i:Loc restore.notEffective}" Style="{StaticResource Text.Overline}"/>
                        <TextBlock i:Motion.CountTo="{Binding NotEffectiveCount}">
                            <TextBlock.Style>
                                <!-- Orange only when something is actually not effective -->
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Metric}">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NotEffectiveCount}" Value="0">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{i:Loc restore.notEffectiveHint}" Style="{StaticResource Text.Caption}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Actions -->
            <WrapPanel Margin="0,0,0,12">
                <Button Style="{StaticResource Button.Primary}" Command="{Binding VerifyNowCommand}" Margin="0,0,8,8">
                    <StackPanel Orientation="Horizontal">
                        <i:Icon Glyph="{StaticResource Icon.Shield}" Width="15" Height="15" Foreground="{DynamicResource Brush.OnAccent}" Margin="0,0,8,0"/>
                        <TextBlock Text="{i:Loc restore.verifyNow}"/>
                    </StackPanel>
                </Button>
                <Button Content="{i:Loc backup.export}" Style="{StaticResource Button.Secondary}" Command="{Binding Pro.ExportBackupsCommand}" Margin="0,0,8,8"/>
                <Button Content="{i:Loc backup.import}" Style="{StaticResource Button.Secondary}" Command="{Binding Pro.ImportBackupsCommand}" Margin="0,0,8,8"/>
                <Button Content="{i:Loc backup.systemRestore}" Style="{StaticResource Button.Secondary}" Command="{Binding Pro.OpenSystemRestoreCommand}" Margin="0,0,8,8"/>
            </WrapPanel>
            <TextBlock Text="{Binding Pro.BackupStatus}" Style="{StaticResource Text.Body}" Margin="0,0,0,10" Visibility="{Binding Pro.BackupStatus, Converter={StaticResource BoolToVis}}"/>

            <Border Style="{StaticResource Banner}" Visibility="{Binding PostRebootText, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding PostRebootText}" Style="{StaticResource Text.Body}"/>
            </Border>

            <!-- Interrupted operations -->
            <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource Brush.Warning}" Visibility="{Binding Interrupted.Count, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{i:Loc restore.interrupted.title}" Style="{StaticResource Text.CardTitle}"/>
                    <TextBlock Text="{i:Loc restore.interrupted.desc}" Style="{StaticResource Text.Muted}" Margin="0,4,0,10"/>
                    <ItemsControl ItemsSource="{Binding Interrupted}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Inset}" Margin="0,0,0,6">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{i:Loc restore.resume.go}" Style="{StaticResource Button.SmallPrimary}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                            <Button Content="{i:Loc restore.dismiss}" Style="{StaticResource Button.Small}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Verification reports -->
            <TextBlock Text="{i:Loc restore.reports}" Style="{StaticResource Text.Section}" Margin="0,8,0,10"/>
            <TextBlock Text="{i:Loc restore.reports.empty}" Style="{StaticResource Text.Muted}" Margin="0,0,0,12"
                       Visibility="{Binding Reports.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
            <ItemsControl ItemsSource="{Binding Reports}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="{StaticResource Pad.CardCompact}" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" Text="{Binding Date}"/>
                                    <TextBlock Style="{StaticResource Text.CardTitle}">
                                        <Run Text="{Binding Effective, Mode=OneWay}"/> / <Run Text="{Binding Total, Mode=OneWay}"/> <Run Text="{i:Loc restore.report.effective}"/>
                                    </TextBlock>
                                </DockPanel>
                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
                                <Expander Header="{i:Loc restore.report.details}" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Lines}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0"/>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Restore by category: only categories that still have restorable changes -->
            <StackPanel Visibility="{Binding Pro.RestorableCategories.Count, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{i:Loc backup.byCategory}" Style="{StaticResource Text.Section}" Margin="0,16,0,10"/>
                <ItemsControl ItemsSource="{Binding Pro.RestorableCategories}" Margin="0,0,0,12">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Text}" Style="{StaticResource Button.Small}" Margin="0,0,6,6"
                                    Command="{Binding DataContext.Pro.RestoreCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Applied batches -->
            <TextBlock Text="{i:Loc backup.batches}" Style="{StaticResource Text.Section}" Margin="0,8,0,10"/>
            <TextBlock Text="{i:Loc restore.batches.empty}" Style="{StaticResource Text.Muted}" Margin="0,0,0,12"
                       Visibility="{Binding Pro.Batches.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
            <ItemsControl ItemsSource="{Binding Pro.Batches}" Margin="0,0,0,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Inset}" Margin="0,0,0,6">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{i:Loc common.restore}" Style="{StaticResource Button.Small}" VerticalAlignment="Center"
                                        Visibility="{Binding CanRestore, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.Pro.RestoreBatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Batch}"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="Medium"/>
                                    <TextBlock Style="{StaticResource Text.Caption}">
                                        <Run Text="{Binding CreatedUtc, Mode=OneWay, StringFormat=g}"/> · <Run Text="{Binding ChangeCount, Mode=OneWay}"/> <Run Text="{i:Loc restore.changesWord}"/> · <Run Text="{Binding StateText, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding RestorePointNote}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- History -->
            <TextBlock Text="{i:Loc backup.history}" Style="{StaticResource Text.Section}" Margin="0,8,0,10"/>
            <TextBlock Text="{i:Loc home.noOpt}" Style="{StaticResource Text.Muted}" Visibility="{Binding Pro.ChangeSets.Count, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
            <ItemsControl ItemsSource="{Binding Pro.ChangeSets}" VirtualizingPanel.IsVirtualizing="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="{StaticResource Pad.CardCompact}" Margin="0,0,0,6">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="{i:Loc common.restore}" Style="{StaticResource Button.Small}" Command="{Binding RestoreCommand}" IsEnabled="{Binding CanRestore}" VerticalAlignment="Top"/>
                                <StackPanel>
                                    <WrapPanel>
                                        <Border Style="{StaticResource Badge}" Background="{Binding Status, Converter={StaticResource LevelBrush}, ConverterParameter=soft}">
                                            <TextBlock Style="{StaticResource Text.Badge}" Text="{Binding StatusLabel}" Foreground="{Binding Status, Converter={StaticResource LevelBrush}}"/>
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Visibility="{Binding HasVerification, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource Text.Badge}" Text="{Binding VerificationLabel}"/>
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontWeight="Medium" VerticalAlignment="Center" Margin="2,0,0,4"/>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Text.Caption}">
                                        <Run Text="{Binding Date, Mode=OneWay}"/> · <Run Text="{Binding Category, Mode=OneWay}"/>
                                    </TextBlock>
                                    <Expander Header="{i:Loc backup.details}" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Details}" FontFamily="{StaticResource Font.Mono}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,6,0,0"/>
                                    </Expander>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
